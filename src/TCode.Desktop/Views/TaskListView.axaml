<!-- 输入框上方的任务清单（task_* 工具的最新快照）：标题“任务 2/5”，可折叠；全部完成后隐藏。 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TCode.Desktop.ViewModels"
             xmlns:icons="using:TCode.Desktop.Icons"
             xmlns:motion="using:TCode.Desktop.Motion"
             x:Class="TCode.Desktop.Views.TaskListView"
             x:DataType="vm:TaskListViewModel"
             IsVisible="{Binding IsVisible}">
    <Border Classes="card" Padding="12,8">
        <StackPanel Spacing="4">
            <Button Theme="{StaticResource TCode.ChipButton}" Padding="2,0,8,0" Command="{Binding ToggleCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:LucideIcon Kind="ListChecks" Width="13" Height="13" VerticalAlignment="Center"
                                      StrokeBrush="{DynamicResource TCode.TextSecondary}" />
                    <TextBlock Text="{Binding Header}" FontSize="13" VerticalAlignment="Center" />
                    <icons:LucideIcon Kind="ChevronRight" Width="11" Height="11" VerticalAlignment="Center"
                                      motion:Turn.IsOn="{Binding IsExpanded}" />
                </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}" Margin="4,2,0,2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskItemViewModel">
                        <Grid ColumnDefinitions="18,*" Margin="0,2">
                            <Panel VerticalAlignment="Center">
                                <icons:LucideIcon Kind="Check" Width="12" Height="12" IsVisible="{Binding IsCompleted}"
                                                  StrokeBrush="{DynamicResource TCode.Success}" />
                                <icons:LucideIcon Kind="ChevronRight" Width="12" Height="12" IsVisible="{Binding IsInProgress}"
                                                  StrokeBrush="{DynamicResource TCode.Accent}" />
                                <Ellipse Width="6" Height="6" IsVisible="{Binding IsPending}" Stroke="{DynamicResource TCode.TextTertiary}"
                                         StrokeThickness="1" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Panel>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Classes.secondary="{Binding IsCompleted}" TextDecorations="{Binding IsCompleted, Converter={x:Static vm:TaskDecorations.Strike}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
