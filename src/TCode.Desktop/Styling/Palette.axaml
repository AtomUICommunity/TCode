<!--
  TCode 专属调色板：AtomUI Token 覆盖不到的界面表面（侧栏、Composer、磁贴等）。
  AtomUI 会根据当前主题设置 Application.RequestedThemeVariant，这里的 ThemeDictionaries 随之切换。
  暗色取值来自参考截图像素采样。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TCode.WindowBg" Color="#141414" />
            <SolidColorBrush x:Key="TCode.SidebarBg" Color="#1A1B1B" />
            <SolidColorBrush x:Key="TCode.Divider" Color="#2B2C2D" />
            <SolidColorBrush x:Key="TCode.HoverBg" Color="#222323" />
            <SolidColorBrush x:Key="TCode.SelectedBg" Color="#272828" />
            <SolidColorBrush x:Key="TCode.ComposerBg" Color="#1B1B1B" />
            <SolidColorBrush x:Key="TCode.ComposerBorder" Color="#353535" />
            <SolidColorBrush x:Key="TCode.PopupBg" Color="#181818" />
            <SolidColorBrush x:Key="TCode.PopupBorder" Color="#383838" />
            <SolidColorBrush x:Key="TCode.InputBg" Color="#1E1E1E" />
            <SolidColorBrush x:Key="TCode.InputBorder" Color="#3D3D3D" />
            <SolidColorBrush x:Key="TCode.PillBorder" Color="#363636" />
            <SolidColorBrush x:Key="TCode.TileBorder" Color="#2B2B2B" />
            <SolidColorBrush x:Key="TCode.TileHoverBg" Color="#262627" />
            <SolidColorBrush x:Key="TCode.TileHoverBorder" Color="#424243" />
            <SolidColorBrush x:Key="TCode.TabActiveBg" Color="#262626" />
            <SolidColorBrush x:Key="TCode.AccentBg" Color="#F0F0F0" />
            <SolidColorBrush x:Key="TCode.AccentFg" Color="#151515" />
            <SolidColorBrush x:Key="TCode.TextPrimary" Color="#F0F0F0" />
            <SolidColorBrush x:Key="TCode.TextSecondary" Color="#9A9A9A" />
            <SolidColorBrush x:Key="TCode.TextTertiary" Color="#6E6E6E" />
            <SolidColorBrush x:Key="TCode.UserBubbleBg" Color="#212121" />
            <SolidColorBrush x:Key="TCode.CardBg" Color="#1A1A1A" />
            <SolidColorBrush x:Key="TCode.CodeBg" Color="#1C1C1C" />
            <SolidColorBrush x:Key="TCode.Success" Color="#40A167" />
            <SolidColorBrush x:Key="TCode.Danger" Color="#E5534B" />
            <SolidColorBrush x:Key="TCode.GitUntracked" Color="#84B8C8" />
            <SolidColorBrush x:Key="TCode.GitModified" Color="#D7BA7D" />
            <SolidColorBrush x:Key="TCode.Accent" Color="#8B7CF6" />
            <SolidColorBrush x:Key="TCode.AccentSoftBg" Color="#2E2A4A" />
            <SolidColorBrush x:Key="TCode.AccentText" Color="#B4A9FF" />
            <!-- StreamMark：行内代码紫色字 + 紫色浅底，列表圆点 / 序号紫色 -->
            <SolidColorBrush x:Key="Md.InlineCodeForeground" Color="#B4A9FF" />
            <SolidColorBrush x:Key="Md.InlineCodeBackground" Color="#2E2A4A" />
            <SolidColorBrush x:Key="Md.ListMarkerForeground" Color="#8B7CF6" />
            <SolidColorBrush x:Key="TCode.MenuBg" Color="#1C1C1E" />
            <SolidColorBrush x:Key="TCode.MenuBorder" Color="#2F2F31" />
            <SolidColorBrush x:Key="TCode.MenuItemHoverBg" Color="#2A2A2C" />
            <SolidColorBrush x:Key="TCode.MenuInputBg" Color="#232325" />
            <SolidColorBrush x:Key="TCode.KbdBg" Color="#2C2C2E" />
            <SolidColorBrush x:Key="TCode.KbdFg" Color="#A0A0A3" />
            <SolidColorBrush x:Key="TCode.RingTrack" Color="#333335" />
            <SolidColorBrush x:Key="TCode.UserBubble" Color="#262627" />
            <SolidColorBrush x:Key="TCode.SegmentSelectedBg" Color="#333335" />
            <SolidColorBrush x:Key="TCode.FileBlue" Color="#5AA2F0" />
            <SolidColorBrush x:Key="TCode.FileYellow" Color="#E2C05C" />
            <SolidColorBrush x:Key="TCode.FilePurple" Color="#A88BF0" />
            <SolidColorBrush x:Key="TCode.FileRed" Color="#E8645A" />
            <SolidColorBrush x:Key="TCode.FileGreen" Color="#5EBE84" />
            <SolidColorBrush x:Key="TCode.FileOrange" Color="#E8915A" />
            <SolidColorBrush x:Key="TCode.FileGray" Color="#9A9A9A" />
            <SolidColorBrush x:Key="TCode.LineNumber" Color="#5C5C5E" />
            <SolidColorBrush x:Key="TCode.SegmentSelectedBorder" Color="#404043" />
            <SolidColorBrush x:Key="TCode.BadgeBg" Color="#3A4150" />
            <SolidColorBrush x:Key="TCode.BadgeFg" Color="#C9D1E0" />
            <SolidColorBrush x:Key="TCode.TreeLine" Color="#3A3A3C" />
            <!-- 背景光晕：主区顶部偏右的灰白光、左侧的暗绿光；侧栏左下的冷色光 -->
            <RadialGradientBrush x:Key="TCode.GlowMain" Center="62%,22%" GradientOrigin="62%,22%" RadiusX="42%" RadiusY="34%">
                <GradientStop Offset="0" Color="#1CFFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="TCode.GlowAccent" Center="18%,30%" GradientOrigin="18%,30%" RadiusX="30%" RadiusY="30%">
                <GradientStop Offset="0" Color="#1A2FB36B" />
                <GradientStop Offset="1" Color="#002FB36B" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="TCode.GlowSidebar" Center="0%,100%" GradientOrigin="0%,100%" RadiusX="90%" RadiusY="45%">
                <GradientStop Offset="0" Color="#1A4A7BA8" />
                <GradientStop Offset="1" Color="#004A7BA8" />
            </RadialGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TCode.WindowBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TCode.SidebarBg" Color="#F7F7F7" />
            <SolidColorBrush x:Key="TCode.Divider" Color="#E6E6E6" />
            <SolidColorBrush x:Key="TCode.HoverBg" Color="#EFEFEF" />
            <SolidColorBrush x:Key="TCode.SelectedBg" Color="#E9E9E9" />
            <SolidColorBrush x:Key="TCode.ComposerBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TCode.ComposerBorder" Color="#D9D9D9" />
            <SolidColorBrush x:Key="TCode.PopupBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TCode.PopupBorder" Color="#E0E0E0" />
            <SolidColorBrush x:Key="TCode.InputBg" Color="#F7F7F7" />
            <SolidColorBrush x:Key="TCode.InputBorder" Color="#DEDEDE" />
            <SolidColorBrush x:Key="TCode.PillBorder" Color="#DEDEDE" />
            <SolidColorBrush x:Key="TCode.TileBorder" Color="#E6E6E6" />
            <SolidColorBrush x:Key="TCode.TileHoverBg" Color="#F4F4F4" />
            <SolidColorBrush x:Key="TCode.TileHoverBorder" Color="#D0D0D0" />
            <SolidColorBrush x:Key="TCode.TabActiveBg" Color="#EDEDED" />
            <SolidColorBrush x:Key="TCode.AccentBg" Color="#1A1A1A" />
            <SolidColorBrush x:Key="TCode.AccentFg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TCode.TextPrimary" Color="#1A1A1A" />
            <SolidColorBrush x:Key="TCode.TextSecondary" Color="#6B6B6B" />
            <SolidColorBrush x:Key="TCode.TextTertiary" Color="#9B9B9B" />
            <SolidColorBrush x:Key="TCode.UserBubbleBg" Color="#F2F2F2" />
            <SolidColorBrush x:Key="TCode.CardBg" Color="#FAFAFA" />
            <SolidColorBrush x:Key="TCode.CodeBg" Color="#F5F5F5" />
            <SolidColorBrush x:Key="TCode.Success" Color="#2F9E5C" />
            <SolidColorBrush x:Key="TCode.Danger" Color="#D1362F" />
            <SolidColorBrush x:Key="TCode.GitUntracked" Color="#2B7A92" />
            <SolidColorBrush x:Key="TCode.GitModified" Color="#9A6B00" />
            <SolidColorBrush x:Key="TCode.Accent" Color="#6E5BEF" />
            <SolidColorBrush x:Key="TCode.AccentSoftBg" Color="#ECE9FE" />
            <SolidColorBrush x:Key="TCode.AccentText" Color="#5A46D6" />
            <!-- StreamMark：行内代码紫色字 + 紫色浅底，列表圆点 / 序号紫色 -->
            <SolidColorBrush x:Key="Md.InlineCodeForeground" Color="#5A46D6" />
            <SolidColorBrush x:Key="Md.InlineCodeBackground" Color="#ECE9FE" />
            <SolidColorBrush x:Key="Md.ListMarkerForeground" Color="#6E5BEF" />
            <SolidColorBrush x:Key="TCode.MenuBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TCode.MenuBorder" Color="#E3E3E6" />
            <SolidColorBrush x:Key="TCode.MenuItemHoverBg" Color="#EFEFF1" />
            <SolidColorBrush x:Key="TCode.MenuInputBg" Color="#F4F4F5" />
            <SolidColorBrush x:Key="TCode.KbdBg" Color="#EDEDEF" />
            <SolidColorBrush x:Key="TCode.KbdFg" Color="#6B6B70" />
            <SolidColorBrush x:Key="TCode.RingTrack" Color="#E2E2E5" />
            <SolidColorBrush x:Key="TCode.UserBubble" Color="#F0F0F1" />
            <SolidColorBrush x:Key="TCode.SegmentSelectedBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TCode.FileBlue" Color="#2F7BD6" />
            <SolidColorBrush x:Key="TCode.FileYellow" Color="#B58A10" />
            <SolidColorBrush x:Key="TCode.FilePurple" Color="#7A55D6" />
            <SolidColorBrush x:Key="TCode.FileRed" Color="#D1453B" />
            <SolidColorBrush x:Key="TCode.FileGreen" Color="#2E9A5A" />
            <SolidColorBrush x:Key="TCode.FileOrange" Color="#C8682C" />
            <SolidColorBrush x:Key="TCode.FileGray" Color="#7A7A7E" />
            <SolidColorBrush x:Key="TCode.LineNumber" Color="#A8A8AC" />
            <SolidColorBrush x:Key="TCode.SegmentSelectedBorder" Color="#DADADD" />
            <SolidColorBrush x:Key="TCode.BadgeBg" Color="#DCE2EC" />
            <SolidColorBrush x:Key="TCode.BadgeFg" Color="#3A4458" />
            <SolidColorBrush x:Key="TCode.TreeLine" Color="#DADADD" />
            <RadialGradientBrush x:Key="TCode.GlowMain" Center="62%,22%" GradientOrigin="62%,22%" RadiusX="42%" RadiusY="34%">
                <GradientStop Offset="0" Color="#0A000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="TCode.GlowAccent" Center="18%,30%" GradientOrigin="18%,30%" RadiusX="30%" RadiusY="30%">
                <GradientStop Offset="0" Color="#102FB36B" />
                <GradientStop Offset="1" Color="#002FB36B" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="TCode.GlowSidebar" Center="0%,100%" GradientOrigin="0%,100%" RadiusX="90%" RadiusY="45%">
                <GradientStop Offset="0" Color="#104A7BA8" />
                <GradientStop Offset="1" Color="#004A7BA8" />
            </RadialGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="TCode.RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="TCode.RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="TCode.RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="TCode.RadiusMenu">10</CornerRadius>
    <BoxShadows x:Key="TCode.MenuShadow">0 8 24 0 #66000000</BoxShadows>
    <FontFamily x:Key="TCode.MonoFont">Menlo, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>
    <x:Double x:Key="TCode.FontSizeBody">13</x:Double>
    <x:Double x:Key="TCode.FontSizeSmall">12</x:Double>
</ResourceDictionary>
