<!-- 分支选择：⑂ 分支名 ⌄ + 弹层（搜索 / 本地分支，当前分支标“当前”）。 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:motion="using:TKCode.Desktop.Motion"
             xmlns:vm="using:TKCode.Desktop.ViewModels"
             xmlns:icons="using:TKCode.Desktop.Icons"
             xmlns:loc="using:TKCode.Desktop.Localization"
             x:Class="TKCode.Desktop.Views.BranchPickerView"
             x:DataType="vm:BranchPickerViewModel">
    <Panel>
        <Button x:Name="Trigger" Theme="{StaticResource TKCode.ChipButton}" Classes.selected="{Binding #Popup.IsOpen}" Click="OnTriggerClick">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:LucideIcon Kind="GitBranch" Width="12" Height="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center" />
                <icons:LucideIcon Kind="ChevronDown" Width="11" Height="11" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <motion:Popover x:Name="Popup" PlacementTarget="{Binding #Trigger}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
               IsLightDismissEnabled="True" Opened="OnPopupOpened" Closed="OnPopupClosed">
            <Border Classes="menu" Width="320" Margin="0,0,16,16">
                <StackPanel Margin="4">
                    <Border Background="{DynamicResource TKCode.MenuInputBg}" CornerRadius="6" Margin="0,0,0,4">
                        <atom:LineEdit x:Name="SearchBox" StyleVariant="Borderless" Background="Transparent"
                                       PlaceholderText="{loc:TKCodeLangResource SearchRefs}" Text="{Binding Search, Mode=TwoWay}" />
                    </Border>
                    <ScrollViewer MaxHeight="260" atom:ScrollViewer.IsLiteMode="True">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BranchItemViewModel">
                                    <Button Theme="{StaticResource TKCode.MenuItem}" Classes.selected="{Binding IsCurrent}" MinHeight="32" Margin="0,1"
                                            Command="{Binding $parent[UserControl].((vm:BranchPickerViewModel)DataContext).SelectCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="strong" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Classes="tertiary" Text="{loc:TKCodeLangResource CurrentRef}" FontSize="11"
                                                       Margin="12,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsCurrent}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <motion:Reveal IsOpen="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Classes="secondary" Text="{Binding Error}" FontSize="12" TextWrapping="Wrap" Margin="8,6"
                                   Foreground="{DynamicResource TKCode.Danger}" />
                    </motion:Reveal>
                    <!-- 切换确认：从列表下方展开 -->
                    <motion:Reveal IsOpen="{Binding IsConfirming}">
                    <StackPanel>
                        <Border Classes="menuDivider" Margin="-4,4" />
                        <StackPanel Margin="8,4,8,6" Spacing="4">
                            <TextBlock Classes="strong" Text="{Binding ConfirmText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource SwitchBranchHint}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <atom:Button SizeType="Small" Color="Default" Variant="Text" Command="{Binding CancelCommand}"
                                             Content="{loc:TKCodeLangResource Cancel}" />
                                <atom:Button SizeType="Small" Color="Default" Variant="Solid" Command="{Binding ConfirmCommand}"
                                             IsLoading="{Binding IsSwitching}" Content="{loc:TKCodeLangResource SwitchBranch}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </motion:Reveal>
                </StackPanel>
            </Border>
        </motion:Popover>
    </Panel>
</UserControl>
