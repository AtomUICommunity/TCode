<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- StreamMark 本地包：在 ../StreamMark 中执行 dotnet pack -o artifacts/packages 生成 -->
    <add key="streammark-local" value="../StreamMark/artifacts/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="streammark-local">
      <package pattern="StreamMark.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
