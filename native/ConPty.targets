<Project>
    <!--
      随包 ConPTY（03-pty.md §11.3–11.4，12-build-and-ci.md §5.5）：Microsoft.Windows.Console.ConPTY 的 conpty.dll 与 OpenConsole.exe。
      不用包自带的 build/ targets：它按 PlatformTarget 选择架构，AnyCPU 的 C# 项目拿不到值，而且只对直接引用生效。
      这里排除包的全部资产，只按 RID 显式复制：
        win-x64   → conpty.dll(x64) + x64\OpenConsole.exe + arm64\OpenConsole.exe（x64 进程可能在 arm64 Windows 上模拟运行）
        win-arm64 → conpty.dll(arm64) + arm64\OpenConsole.exe
      只由可执行项目导入（tcode-ptyhost、Pty 测试）：库项目经 ProjectReference 构建时不带 RuntimeIdentifier，会按本机 RID 选错架构。
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Windows.Console.ConPTY" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    </ItemGroup>
    <PropertyGroup>
        <ConPtyRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</ConPtyRid>
        <ConPtyRid Condition="'$(ConPtyRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</ConPtyRid>
        <ConPtyPackageDir>$(PkgMicrosoft_Windows_Console_ConPTY)</ConPtyPackageDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(ConPtyPackageDir)' != '' and ('$(ConPtyRid)' == 'win-x64' or '$(ConPtyRid)' == 'win-arm64')">
        <None Include="$(ConPtyPackageDir)/runtimes/$(ConPtyRid)/native/conpty.dll" Link="conpty.dll"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
        <None Include="$(ConPtyPackageDir)/build/native/runtimes/arm64/OpenConsole.exe" Link="arm64/OpenConsole.exe"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
        <None Condition="'$(ConPtyRid)' == 'win-x64'" Include="$(ConPtyPackageDir)/build/native/runtimes/x64/OpenConsole.exe" Link="x64/OpenConsole.exe"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
</Project>
