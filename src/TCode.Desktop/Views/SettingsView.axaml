<!--
  设置页（全页）：左侧导航（返回 / 通用 / 模型与厂商 / 关于），右侧内容。
  所有修改写入 ~/.tcode/settings.json；在编辑器里修改同样会被监听并生效。
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:motion="using:TCode.Desktop.Motion"
             xmlns:vm="using:TCode.Desktop.ViewModels"
             xmlns:icons="using:TCode.Desktop.Icons"
             xmlns:loc="using:TCode.Desktop.Localization"
             xmlns:views="using:TCode.Desktop.Views"
             x:Class="TCode.Desktop.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel">
    <Grid ColumnDefinitions="220,*">
        <!-- ===== 左侧导航 ===== -->
        <Border Background="{DynamicResource TCode.SidebarBg}" BorderBrush="{DynamicResource TCode.Divider}" BorderThickness="0,0,1,0">
            <Panel>
                <Border Background="{DynamicResource TCode.GlowSidebar}" IsHitTestVisible="False" />
                <DockPanel>
                    <Panel x:Name="NavHeader" DockPanel.Dock="Top" Height="44" Background="Transparent"
                           WindowDecorationProperties.ElementRole="TitleBar" />
                    <StackPanel Margin="8,4,8,8" Spacing="1">
                        <Button Theme="{StaticResource TCode.RowButton}" Command="{Binding CloseSettingsCommand}" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <icons:LucideIcon Kind="ArrowLeft" Width="14" Height="14" />
                                <TextBlock Classes="secondary" Text="{loc:TCodeLangResource BackToApp}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Settings.Nav}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsNavItemViewModel">
                                    <Button Theme="{StaticResource TCode.RowButton}" Classes.selected="{Binding IsSelected}" Margin="0,0,0,1"
                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.NavigateCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <icons:LucideIcon Kind="{Binding Icon}" Width="14" Height="14" />
                                            <TextBlock Classes="strong" Text="{Binding Title}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Panel>
        </Border>

        <!-- ===== 右侧内容 ===== -->
        <DockPanel Grid.Column="1" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
            <Panel DockPanel.Dock="Top" Height="44" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar" />
            <Panel>
            <!-- ========== 模型与厂商（主从双栏，各自滚动） ========== -->
            <views:ProvidersSettingsView motion:Presence.IsPresent="{Binding IsProviders}" motion:Presence.Effect="SlideUp" motion:Presence.AnimateExit="False" />
            <ScrollViewer motion:Presence.IsPresent="{Binding !IsProviders}" motion:Presence.Effect="SlideUp" motion:Presence.AnimateExit="False" atom:ScrollViewer.IsLiteMode="True">
                <StackPanel MaxWidth="760" Margin="40,0,40,48" Spacing="16">
                    <!-- 配置错误 -->
                    <Border CornerRadius="10" Padding="14,10" BorderThickness="1" BorderBrush="{DynamicResource TCode.Danger}"
                            IsVisible="{Binding HasErrors}">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <icons:LucideIcon Kind="CircleAlert" Width="14" Height="14" StrokeBrush="{DynamicResource TCode.Danger}" />
                                <TextBlock Classes="strong" Text="{loc:TCodeLangResource SettingsErrorsTitle}" Foreground="{DynamicResource TCode.Danger}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <SelectableTextBlock Text="{Binding}" FontSize="12" FontFamily="{StaticResource TCode.MonoFont}" TextWrapping="Wrap"
                                                             Foreground="{DynamicResource TCode.TextSecondary}" Margin="22,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ========== 通用 ========== -->
                    <StackPanel Spacing="16" motion:Presence.IsPresent="{Binding IsGeneral}" motion:Presence.Effect="SlideUp" motion:Presence.AnimateExit="False">
                        <TextBlock Text="{loc:TCodeLangResource SettingsGeneral}" FontSize="20" FontWeight="SemiBold" />
                        <Border Classes="card">
                            <StackPanel>
                                <!-- 语言 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <TextBlock Classes="strong" Text="{loc:TCodeLangResource LanguageLabel}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Classes="segmented">
                                        <ItemsControl ItemsSource="{Binding Languages}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SettingsChoiceViewModel">
                                                    <Button Theme="{StaticResource TCode.RowButton}" Classes.selected="{Binding IsSelected}" Content="{Binding Label}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.ChooseLanguageCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource TCode.Divider}" />
                                <!-- 主题 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <TextBlock Classes="strong" Text="{loc:TCodeLangResource ThemeLabel}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Classes="segmented">
                                        <ItemsControl ItemsSource="{Binding Themes}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SettingsChoiceViewModel">
                                                    <Button Theme="{StaticResource TCode.RowButton}" Classes.selected="{Binding IsSelected}" Content="{Binding Label}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.ChooseThemeCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource TCode.Divider}" />
                                <!-- 减少动态效果 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="strong" Text="{loc:TCodeLangResource ReduceMotionLabel}" />
                                        <TextBlock Classes="tertiary" Text="{loc:TCodeLangResource ReduceMotionHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <atom:ToggleSwitch Grid.Column="1" SizeType="Small" VerticalAlignment="Center" IsChecked="{Binding ReduceMotion}" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource TCode.Divider}" />
                                <!-- 默认模型 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="strong" Text="{loc:TCodeLangResource DefaultModelLabel}" />
                                        <TextBlock Classes="tertiary" Text="{loc:TCodeLangResource DefaultModelHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Panel Grid.Column="1" Margin="16,0,0,0">
                                        <Button x:Name="DefaultModelButton" Theme="{StaticResource TCode.ChipButton}" MinHeight="30" Padding="10,0"
                                                Foreground="{DynamicResource TCode.TextPrimary}" Click="OnDefaultModelClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DefaultModelLabel}" MaxWidth="260"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <icons:LucideIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <motion:Popover x:Name="DefaultModelPopup" PlacementTarget="{Binding #DefaultModelButton}" Placement="BottomEdgeAlignedRight"
                                               VerticalOffset="6" IsLightDismissEnabled="True">
                                            <Border Classes="menu" Width="320" Margin="16,0,16,16">
                                                <ScrollViewer MaxHeight="320" atom:ScrollViewer.IsLiteMode="True">
                                                    <ItemsControl ItemsSource="{Binding DefaultModels}" Margin="4">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:SettingsChoiceViewModel">
                                                                <Button Theme="{StaticResource TCode.MenuItem}" Classes.selected="{Binding IsSelected}" MinHeight="30"
                                                                        Click="OnDefaultModelChosen"
                                                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.ChooseDefaultModelCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        <icons:LucideIcon Grid.Column="1" Kind="Check" Width="13" Height="13" IsVisible="{Binding IsSelected}" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </motion:Popover>
                                    </Panel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 模型目录：手动检查更新 → 查看差异 → 应用 -->
                        <Border Classes="card" Padding="16,12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="strong" Text="{loc:TCodeLangResource CatalogTitle}" />
                                        <TextBlock Classes="secondary" Text="{Binding CatalogSourceText}" FontSize="12" />
                                        <TextBlock Classes="tertiary" Text="{Binding CatalogCountsText}" />
                                    </StackPanel>
                                    <atom:Button Grid.Column="1" SizeType="Small" Color="Default" Variant="Outlined" VerticalAlignment="Center"
                                                 Command="{Binding CheckCatalogCommand}" IsLoading="{Binding IsCheckingCatalog}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <icons:LucideIcon Kind="RefreshCw" Width="12" Height="12" />
                                            <TextBlock Text="{loc:TCodeLangResource CheckForUpdates}" FontSize="12" />
                                        </StackPanel>
                                    </atom:Button>
                                </Grid>
                                <TextBlock Text="{Binding CatalogErrorText}" FontSize="12" Foreground="{DynamicResource TCode.Danger}" TextWrapping="Wrap"
                                           IsVisible="{Binding HasCatalogError}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsUpToDate}">
                                    <icons:LucideIcon Kind="Check" Width="13" Height="13" StrokeBrush="{DynamicResource TCode.Success}" />
                                    <TextBlock Text="{loc:TCodeLangResource CatalogUpToDate}" FontSize="12" Foreground="{DynamicResource TCode.Success}" />
                                </StackPanel>
                                <TextBlock Classes="tertiary" Text="{loc:TCodeLangResource CatalogHint}" TextWrapping="Wrap" />

                                <!-- 待应用的更新：差异 -->
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource TCode.Accent}" Padding="12,10" Margin="0,4,0,0"
                                        IsVisible="{Binding HasPendingUpdate}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="strong" Text="{loc:TCodeLangResource CatalogUpdateTitle}" />
                                                <TextBlock Classes="secondary" Text="{Binding UpdateSummaryText}" FontSize="12" />
                                            </StackPanel>
                                            <atom:Button Grid.Column="1" SizeType="Small" Color="Default" Variant="Text" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Command="{Binding DiscardCatalogUpdateCommand}" Content="{loc:TCodeLangResource Discard}" />
                                            <atom:Button Grid.Column="2" SizeType="Small" Color="Default" Variant="Solid" VerticalAlignment="Center"
                                                         Command="{Binding ApplyCatalogUpdateCommand}" Content="{loc:TCodeLangResource ApplyUpdate}" />
                                        </Grid>
                                        <atom:CheckBox IsChecked="{Binding ShowOnlyConfiguredChanges, Mode=TwoWay}" Content="{loc:TCodeLangResource OnlyConfiguredProviders}" />
                                        <TextBlock Classes="secondary" Text="{loc:TCodeLangResource NoRelevantChanges}" FontSize="12" IsVisible="{Binding HasNoVisibleChanges}" />
                                        <ScrollViewer MaxHeight="420" atom:ScrollViewer.IsLiteMode="True">
                                            <ItemsControl ItemsSource="{Binding CatalogChanges}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CatalogProviderChangeItemViewModel">
                                                        <StackPanel Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <icons:ProviderLogo Key="{Binding LogoKey}" Width="14" Height="14" VerticalAlignment="Center" />
                                                                <TextBlock Classes="strong" Text="{Binding Name}" VerticalAlignment="Center" />
                                                                <Border Background="{DynamicResource TCode.KbdBg}" CornerRadius="4" Padding="5,0" VerticalAlignment="Center">
                                                                    <TextBlock Classes="tertiary" Text="{Binding KindText}" FontSize="11" />
                                                                </Border>
                                                                <TextBlock Classes="tertiary" Text="{Binding SummaryText}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <ItemsControl ItemsSource="{Binding Changes}" Margin="22,0,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:CatalogFieldChangeItemViewModel">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <TextBlock Classes="tertiary" Text="{Binding Label}" />
                                                                            <TextBlock Classes="tertiary" Text="{Binding OldText}" TextDecorations="Strikethrough" />
                                                                            <TextBlock Classes="tertiary" Text="→" />
                                                                            <TextBlock Text="{Binding NewText}" FontSize="12" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <ItemsControl ItemsSource="{Binding Models}" Margin="22,0,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:CatalogModelChangeItemViewModel">
                                                                        <StackPanel Margin="0,2">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <TextBlock Text="+" FontWeight="Bold" Foreground="{DynamicResource TCode.Success}" IsVisible="{Binding IsAdded}" />
                                                                                <TextBlock Text="−" FontWeight="Bold" Foreground="{DynamicResource TCode.Danger}" IsVisible="{Binding IsRemoved}" />
                                                                                <TextBlock Text="~" FontWeight="Bold" Foreground="{DynamicResource TCode.GitModified}" IsVisible="{Binding IsChanged}" />
                                                                                <TextBlock Text="{Binding Name}" FontSize="12" />
                                                                                <TextBlock Classes="tertiary" Text="{Binding Id}" FontFamily="{StaticResource TCode.MonoFont}" IsVisible="{Binding ShowId}" />
                                                                            </StackPanel>
                                                                            <ItemsControl ItemsSource="{Binding Changes}" Margin="18,0,0,0">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:CatalogFieldChangeItemViewModel">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                            <TextBlock Classes="tertiary" Text="{Binding Label}" />
                                                                                            <TextBlock Classes="tertiary" Text="{Binding OldText}" TextDecorations="Strikethrough" />
                                                                                            <TextBlock Classes="tertiary" Text="→" />
                                                                                            <TextBlock Text="{Binding NewText}" FontSize="12" />
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Classes="tertiary" Text="{Binding MoreText}" Margin="22,0,0,0" IsVisible="{Binding HasMore}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 配置文件 -->
                        <Border Classes="card" Padding="16,12">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="strong" Text="{loc:TCodeLangResource SettingsFileLabel}" />
                                <SelectableTextBlock Text="{Binding SettingsPath}" FontFamily="{StaticResource TCode.MonoFont}" FontSize="12"
                                                     Foreground="{DynamicResource TCode.TextSecondary}" />
                                <TextBlock Classes="tertiary" Text="{loc:TCodeLangResource SettingsFileHint}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <atom:Button SizeType="Small" Color="Default" Variant="Outlined" Command="{Binding OpenSettingsFileCommand}"
                                                 Content="{loc:TCodeLangResource OpenInEditor}" />
                                    <atom:Button SizeType="Small" Color="Default" Variant="Text" Command="{Binding RevealSettingsFileCommand}"
                                                 Content="{loc:TCodeLangResource RevealInFolder}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 智能体（外部运行时，自动检测） ========== -->
                    <StackPanel Spacing="14" motion:Presence.IsPresent="{Binding IsAgents}" motion:Presence.Effect="SlideUp" motion:Presence.AnimateExit="False">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:TCodeLangResource SettingsAgents}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Classes="secondary" Text="{loc:TCodeLangResource AgentsHint}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                        <TextBlock Classes="secondary" Text="{loc:TCodeLangResource NoRuntimes}" IsVisible="{Binding HasNoRuntimes}" />
                        <ItemsControl ItemsSource="{Binding InstalledRuntimes}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuntimeItemViewModel">
                                    <Border Classes="card" Padding="16,12">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <icons:ProviderLogo Key="{Binding LogoKey}" Width="24" Height="24" VerticalAlignment="Top" Margin="0,2,12,0" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Classes="strong" Text="{Binding Name}" />
                                                    <TextBlock Classes="tertiary" Text="{Binding Id}" FontFamily="{StaticResource TCode.MonoFont}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Classes="secondary" Text="{Binding VersionText}" FontSize="12" IsVisible="{Binding HasVersion}" />
                                                    <TextBlock Classes="secondary" Text="{Binding AuthText}" FontSize="12" IsVisible="{Binding HasAuth}" />
                                                    <TextBlock Classes="secondary" Text="{Binding ModelsText}" FontSize="12" />
                                                </StackPanel>
                                                <TextBlock Classes="tertiary" Text="{Binding Dto.ExecutablePath}" FontFamily="{StaticResource TCode.MonoFont}"
                                                           TextTrimming="CharacterEllipsis" IsVisible="{Binding HasPath}" />
                                                <TextBlock Text="{Binding Dto.Error}" FontSize="12" Foreground="{DynamicResource TCode.Danger}" TextWrapping="Wrap"
                                                           IsVisible="{Binding HasError}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Background="{DynamicResource TCode.MenuInputBg}" VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource TCode.Success}" IsVisible="{Binding IsReady}" />
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource TCode.Danger}" IsVisible="{Binding IsError}" />
                                                    <TextBlock Classes="secondary" Text="{Binding StatusText}" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 未安装：默认折叠 -->
                        <StackPanel Spacing="6" IsVisible="{Binding HasMissingRuntimes}">
                            <Button Theme="{StaticResource TCode.ChipButton}" Command="{Binding ToggleMissingRuntimesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:LucideIcon Kind="ChevronRight" Width="11" Height="11" IsVisible="{Binding !ShowMissingRuntimes}" />
                                    <icons:LucideIcon Kind="ChevronDown" Width="11" Height="11" IsVisible="{Binding ShowMissingRuntimes}" />
                                    <TextBlock Text="{Binding MissingRuntimesTitle}" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding MissingRuntimes}" IsVisible="{Binding ShowMissingRuntimes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RuntimeItemViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,4">
                                            <icons:ProviderLogo Key="{Binding LogoKey}" Width="16" Height="16" Opacity="0.6" />
                                            <TextBlock Classes="secondary" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Classes="tertiary" Text="{Binding Id}" FontFamily="{StaticResource TCode.MonoFont}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========== 关于 ========== -->
                    <StackPanel Spacing="16" motion:Presence.IsPresent="{Binding IsAbout}" motion:Presence.Effect="SlideUp" motion:Presence.AnimateExit="False">
                        <TextBlock Text="{loc:TCodeLangResource SettingsAbout}" FontSize="20" FontWeight="SemiBold" />
                        <Border Classes="card" Padding="16,14">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="strong" Text="TCode" FontSize="15" />
                                <TextBlock Classes="secondary" Text="{Binding VersionText}" />
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="tertiary" Text="{loc:TCodeLangResource AboutDataDir}" />
                                    <SelectableTextBlock Text="{Binding DataDirectory}" FontFamily="{StaticResource TCode.MonoFont}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Classes="secondary" Text="{Binding CatalogText}" TextWrapping="Wrap" />
                                <TextBlock Classes="secondary" Text="{loc:TCodeLangResource AboutIcons}" TextWrapping="Wrap" />
                                <TextBlock Classes="secondary" Text="{loc:TCodeLangResource AboutUi}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </Panel>
        </DockPanel>
    </Grid>
</UserControl>
