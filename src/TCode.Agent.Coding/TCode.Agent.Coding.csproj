<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>TCode.Agent.Coding</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\TCode.Agent\TCode.Agent.csproj" />
        <ProjectReference Include="..\TCode.Config\TCode.Config.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AngleSharp" />
    </ItemGroup>
    <ItemGroup>
        <!-- 内置提示词型 command（/init、/commit）的正文，见 BuiltinPromptCommands -->
        <EmbeddedResource Include="Assets\BuiltinPrompts\*.md" LogicalName="TCode.Agent.Coding.Assets.BuiltinPrompts.%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TCode.Agent.Tests" />
    </ItemGroup>
</Project>
