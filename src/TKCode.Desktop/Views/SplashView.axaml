<!--
  启动加载页：窗口打开后先显示，后台连接 Agent Host、加载模型与会话；完成后缩放淡出，主界面接着入场。
  Logo 浮动 + 光晕呼吸，下方是 TKCode 字标、加载指示，以及轮播的歇后语（前半句先出现，后半句稍后揭晓）。
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TKCode.Desktop.Controls"
             xmlns:loc="using:TKCode.Desktop.Localization"
             x:Class="TKCode.Desktop.Views.SplashView"
             Background="{DynamicResource TKCode.WindowBg}">
    <UserControl.Styles>
        <!-- 浮动与呼吸只在动效开启时加上 .alive（见 SplashView.axaml.cs） -->
        <Style Selector="Image#Logo.alive">
            <Style.Animations>
                <Animation Duration="0:0:2.6" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="2" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="-6" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse#Halo.alive">
            <Style.Animations>
                <Animation Duration="0:0:2.6" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.45" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.9" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1.12" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.12" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Border Background="{DynamicResource TKCode.GlowMain}" IsHitTestVisible="False" />
        <Border Background="{DynamicResource TKCode.GlowAccent}" IsHitTestVisible="False" />
        <!-- 加载期间也能拖动窗口 -->
        <Panel Height="44" VerticalAlignment="Top" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar" />

        <StackPanel x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,0,32,48" Spacing="0">
            <Panel x:Name="LogoBox" Width="132" Height="132" HorizontalAlignment="Center">
                <Ellipse x:Name="Halo" Width="132" Height="132" IsHitTestVisible="False" Opacity="0.6">
                    <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#668B7CF6" />
                            <GradientStop Offset="0.55" Color="#228B7CF6" />
                            <GradientStop Offset="1" Color="#008B7CF6" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Image x:Name="Logo" Source="avares://TKCode/Assets/app-logo.png" Width="76" Height="76"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image.RenderTransform><TranslateTransform /></Image.RenderTransform>
                </Image>
            </Panel>

            <TextBlock x:Name="Wordmark" Text="TKCode" FontSize="34" FontWeight="Bold" LetterSpacing="1.5"
                       HorizontalAlignment="Center" Margin="0,6,0,0">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#A78BFA" />
                        <GradientStop Offset="0.5" Color="#E879A6" />
                        <GradientStop Offset="1" Color="#60A5FA" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>

            <StackPanel x:Name="LoadingRow" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,14,0,0">
                <controls:DotSpinner Width="12" Height="12" VerticalAlignment="Center" />
                <TextBlock Classes="secondary" FontSize="12" VerticalAlignment="Center" Text="{loc:TKCodeLangResource SplashLoading}" />
            </StackPanel>

            <!-- 歇后语：前半句 —— 后半句 -->
            <StackPanel x:Name="Quip" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0" MinHeight="22">
                <TextBlock x:Name="QuipSetup" Classes="secondary" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="QuipDash" Classes="tertiary" FontSize="14" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock x:Name="QuipPunch" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TKCode.AccentText}" />
            </StackPanel>
        </StackPanel>
    </Panel>
</UserControl>
