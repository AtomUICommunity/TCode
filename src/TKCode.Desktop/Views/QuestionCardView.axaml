<!--
  转录里的问答卡片（docs/design/ask-user.md §7.4）：Agent 的提问与用户的回答，独立显示，不收进活动组。
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TKCode.Desktop.ViewModels"
             xmlns:icons="using:TKCode.Desktop.Icons"
             xmlns:controls="using:TKCode.Desktop.Controls"
             x:Class="TKCode.Desktop.Views.QuestionCardView"
             x:DataType="vm:QuestionCardViewModel">
    <Border Classes="card" Padding="14,10" Margin="0,4">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <icons:LucideIcon Kind="MessageCircleQuestion" Width="14" Height="14" VerticalAlignment="Center"
                                  StrokeBrush="{DynamicResource TKCode.TextSecondary}" />
                <TextBlock Classes="strong" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                <controls:DotSpinner Width="10" Height="10" VerticalAlignment="Center" IsVisible="{Binding IsPending}" />
                <TextBlock Classes="tertiary" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuestionCardLine">
                        <Grid ColumnDefinitions="Auto,*" Margin="22,0,0,0">
                            <Border Classes="kbd" VerticalAlignment="Top" Margin="0,1,10,0">
                                <TextBlock Text="{Binding Header}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <SelectableTextBlock Classes="secondary" Text="{Binding Question}" FontSize="12" TextWrapping="Wrap" />
                                <SelectableTextBlock Text="{Binding Answer}" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding IsAnswered}" />
                                <TextBlock Classes="tertiary" Text="{Binding Answer}" FontSize="13" TextWrapping="Wrap"
                                           IsVisible="{Binding ShowPlaceholder}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
