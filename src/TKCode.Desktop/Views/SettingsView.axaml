<!--
  设置页（全页）：左侧导航（返回 / 通用 / 模型与厂商 / 关于），右侧内容。
  所有修改写入 ~/.tkcode/settings.json；在编辑器里修改同样会被监听并生效。
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:motion="using:TKCode.Desktop.Motion"
             xmlns:controls="using:TKCode.Desktop.Controls"
             xmlns:vm="using:TKCode.Desktop.ViewModels"
             xmlns:icons="using:TKCode.Desktop.Icons"
             xmlns:loc="using:TKCode.Desktop.Localization"
             xmlns:views="using:TKCode.Desktop.Views"
             xmlns:smv="using:StreamMark.Avalonia"
             x:Class="TKCode.Desktop.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <!-- 命令、Skills 与模式：一项（名称、描述、来源，打开 / 在文件夹中显示） -->
        <DataTemplate x:Key="AssetItemTemplate" x:DataType="vm:AssetItemViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="16,10">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="strong" Text="{Binding Title}" />
                        <Border CornerRadius="4" Padding="5,0" Background="{DynamicResource TKCode.MenuInputBg}" VerticalAlignment="Center">
                            <TextBlock Classes="tertiary" FontSize="11" Text="{Binding Source}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
                    <TextBlock Classes="tertiary" FontSize="11" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="12,0,0,0">
                    <atom:Button SizeType="Small" Color="Default" Variant="Text" Command="{Binding Owner.OpenCommand}" CommandParameter="{Binding}"
                                 Content="{loc:TKCodeLangResource OpenInEditor}" />
                    <atom:Button SizeType="Small" Color="Default" Variant="Text" Command="{Binding Owner.RevealCommand}" CommandParameter="{Binding}"
                                 ToolTip.Tip="{loc:TKCodeLangResource RevealInFolder}">
                        <atom:Button.Icon><icons:LucideIcon Kind="Folder" /></atom:Button.Icon>
                    </atom:Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid ColumnDefinitions="220,*">
        <!-- ===== 左侧导航 ===== -->
        <Border Background="{DynamicResource TKCode.SidebarBg}" BorderBrush="{DynamicResource TKCode.Divider}" BorderThickness="0,0,1,0">
            <Panel>
                <Border Background="{DynamicResource TKCode.GlowSidebar}" IsHitTestVisible="False" />
                <DockPanel>
                    <Panel x:Name="NavHeader" DockPanel.Dock="Top" Height="44" Background="Transparent"
                           WindowDecorationProperties.ElementRole="TitleBar" />
                    <StackPanel Margin="8,4,8,8" Spacing="1">
                        <Button Theme="{StaticResource TKCode.RowButton}" Command="{Binding CloseSettingsCommand}" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <icons:LucideIcon Kind="ArrowLeft" Width="14" Height="14" />
                                <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource BackToApp}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Settings.Nav}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsNavItemViewModel">
                                    <Button Theme="{StaticResource TKCode.RowButton}" Classes.selected="{Binding IsSelected}" Margin="0,0,0,1"
                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.NavigateCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <icons:LucideIcon Kind="{Binding Icon}" Width="14" Height="14" />
                                            <TextBlock Classes="strong" Text="{Binding Title}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Panel>
        </Border>

        <!-- ===== 右侧内容 ===== -->
        <DockPanel Grid.Column="1" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
            <Panel DockPanel.Dock="Top" Height="44" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar" />
            <Panel>
            <!-- ========== 模型与厂商（主从双栏，各自滚动） ========== -->
            <views:ProvidersSettingsView motion:Presence.IsPresent="{Binding IsProviders}" motion:Presence.Effect="SlideUp" motion:Presence.AnimateExit="False" />
            <!-- ========== MCP 服务器（主从双栏） ========== -->
            <views:McpSettingsView DataContext="{Binding Mcp}" motion:Presence.IsPresent="{Binding $parent[DockPanel].((vm:SettingsViewModel)DataContext).IsMcp}"
                                   motion:Presence.Effect="SlideUp" motion:Presence.AnimateExit="False" />
            <ScrollViewer motion:Presence.IsPresent="{Binding IsScrollSection}" motion:Presence.Effect="SlideUp" motion:Presence.AnimateExit="False" atom:ScrollViewer.IsLiteMode="True">
                <StackPanel MaxWidth="760" Margin="40,0,40,48" Spacing="16">
                    <!-- 配置错误 -->
                    <Border CornerRadius="10" Padding="14,10" BorderThickness="1" BorderBrush="{DynamicResource TKCode.Danger}"
                            IsVisible="{Binding HasErrors}">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <icons:LucideIcon Kind="CircleAlert" Width="14" Height="14" StrokeBrush="{DynamicResource TKCode.Danger}" />
                                <TextBlock Classes="strong" Text="{loc:TKCodeLangResource SettingsErrorsTitle}" Foreground="{DynamicResource TKCode.Danger}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <SelectableTextBlock Text="{Binding}" FontSize="12" FontFamily="{StaticResource TKCode.MonoFont}" TextWrapping="Wrap"
                                                             Foreground="{DynamicResource TKCode.TextSecondary}" Margin="22,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ========== 通用 ========== -->
                    <StackPanel Spacing="16" motion:Presence.IsPresent="{Binding IsGeneral}" motion:Presence.Effect="SlideUp" motion:Presence.AnimateExit="False">
                        <TextBlock Text="{loc:TKCodeLangResource SettingsGeneral}" FontSize="20" FontWeight="SemiBold" />
                        <Border Classes="card">
                            <StackPanel>
                                <TextBlock Classes="strong" Text="{loc:TKCodeLangResource ModelConfiguration}" Margin="16,12,16,0" />
                                <!-- 默认模型 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Classes="strong" Text="{loc:TKCodeLangResource DefaultModelLabel}" />
                                        <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource DefaultModelHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Panel Grid.Column="1" Margin="16,0,0,0">
                                        <Button x:Name="DefaultModelButton" Theme="{StaticResource TKCode.ChipButton}" MinHeight="30" Padding="10,0"
                                                Foreground="{DynamicResource TKCode.TextPrimary}" Click="OnDefaultModelClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DefaultModelLabel}" MaxWidth="260"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <icons:LucideIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <motion:Popover x:Name="DefaultModelPopup" PlacementTarget="{Binding #DefaultModelButton}" Placement="BottomEdgeAlignedRight"
                                               VerticalOffset="6" IsLightDismissEnabled="True">
                                            <controls:ZoomHost>
                                            <Border Classes="menu" Width="320" Margin="16,0,16,16">
                                                <ScrollViewer MaxHeight="320" atom:ScrollViewer.IsLiteMode="True">
                                                    <ItemsControl ItemsSource="{Binding DefaultModels}" Margin="4">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:SettingsChoiceViewModel">
                                                                <Button Theme="{StaticResource TKCode.MenuItem}" Classes.selected="{Binding IsSelected}" MinHeight="30"
                                                                        Click="OnDefaultModelChosen"
                                                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.ChooseDefaultModelCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        <icons:LucideIcon Grid.Column="1" Kind="Check" Width="13" Height="13" IsVisible="{Binding IsSelected}" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                            </controls:ZoomHost>
                                        </motion:Popover>
                                    </Panel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource TKCode.Divider}" />
                                <!-- 快速模型 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Classes="strong" Text="{loc:TKCodeLangResource FastModelLabel}" />
                                        <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource FastModelHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Panel Grid.Column="1" Margin="16,0,0,0">
                                        <Button x:Name="FastModelButton" Theme="{StaticResource TKCode.ChipButton}" MinHeight="30" Padding="10,0"
                                                Foreground="{DynamicResource TKCode.TextPrimary}" Click="OnFastModelClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding FastModelLabel}" MaxWidth="260"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <icons:LucideIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <motion:Popover x:Name="FastModelPopup" PlacementTarget="{Binding #FastModelButton}" Placement="BottomEdgeAlignedRight"
                                               VerticalOffset="6" IsLightDismissEnabled="True">
                                            <controls:ZoomHost>
                                            <Border Classes="menu" Width="320" Margin="16,0,16,16">
                                                <ScrollViewer MaxHeight="320" atom:ScrollViewer.IsLiteMode="True">
                                                    <ItemsControl ItemsSource="{Binding FastModels}" Margin="4">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:SettingsChoiceViewModel">
                                                                <Button Theme="{StaticResource TKCode.MenuItem}" Classes.selected="{Binding IsSelected}" MinHeight="30"
                                                                        Click="OnFastModelChosen"
                                                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.ChooseFastModelCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        <icons:LucideIcon Grid.Column="1" Kind="Check" Width="13" Height="13" IsVisible="{Binding IsSelected}" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                            </controls:ZoomHost>
                                        </motion:Popover>
                                    </Panel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel>
                                <!-- 语言 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <TextBlock Classes="strong" Text="{loc:TKCodeLangResource LanguageLabel}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Classes="segmented">
                                        <!-- 选中底板在选项之间滑动 -->
                                        <motion:IndicatorPanel IndicatorBrush="{DynamicResource TKCode.SegmentSelectedBg}" IndicatorBorderBrush="{DynamicResource TKCode.SegmentSelectedBorder}" IndicatorRadius="6">
                                        <ItemsControl ItemsSource="{Binding Languages}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SettingsChoiceViewModel">
                                                    <Button Theme="{StaticResource TKCode.RowButton}" Classes.selected="{Binding IsSelected}" motion:IndicatorPanel.IsCurrent="{Binding IsSelected}" Content="{Binding Label}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.ChooseLanguageCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </motion:IndicatorPanel>
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource TKCode.Divider}" />
                                <!-- 主题 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <TextBlock Classes="strong" Text="{loc:TKCodeLangResource ThemeLabel}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Classes="segmented">
                                        <!-- 选中底板在选项之间滑动 -->
                                        <motion:IndicatorPanel IndicatorBrush="{DynamicResource TKCode.SegmentSelectedBg}" IndicatorBorderBrush="{DynamicResource TKCode.SegmentSelectedBorder}" IndicatorRadius="6">
                                        <ItemsControl ItemsSource="{Binding Themes}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SettingsChoiceViewModel">
                                                    <Button Theme="{StaticResource TKCode.RowButton}" Classes.selected="{Binding IsSelected}" motion:IndicatorPanel.IsCurrent="{Binding IsSelected}" Content="{Binding Label}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.ChooseThemeCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </motion:IndicatorPanel>
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource TKCode.Divider}" />
                                <!-- 界面缩放 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Classes="strong" Text="{loc:TKCodeLangResource UiScaleLabel}" />
                                        <TextBlock Classes="tertiary" Text="{Binding UiScaleHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
                                        <motion:IndicatorPanel IndicatorBrush="{DynamicResource TKCode.SegmentSelectedBg}" IndicatorBorderBrush="{DynamicResource TKCode.SegmentSelectedBorder}" IndicatorRadius="6">
                                        <ItemsControl ItemsSource="{Binding UiScales}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SettingsChoiceViewModel">
                                                    <Button Theme="{StaticResource TKCode.RowButton}" Classes.selected="{Binding IsSelected}" motion:IndicatorPanel.IsCurrent="{Binding IsSelected}" Content="{Binding Label}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.ChooseUiScaleCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </motion:IndicatorPanel>
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource TKCode.Divider}" />
                                <!-- 关闭窗口时保留在托盘 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="strong" Text="{loc:TKCodeLangResource CloseToTrayLabel}" />
                                        <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource CloseToTrayHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <atom:ToggleSwitch Grid.Column="1" SizeType="Small" VerticalAlignment="Center" IsChecked="{Binding CloseToTray}" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource TKCode.Divider}" />
                                <!-- 减少动态效果 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="strong" Text="{loc:TKCodeLangResource ReduceMotionLabel}" />
                                        <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource ReduceMotionHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <atom:ToggleSwitch Grid.Column="1" SizeType="Small" VerticalAlignment="Center" IsChecked="{Binding ReduceMotion}" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource TKCode.Divider}" />
                                <!-- 图片原始清晰度 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="strong" Text="{loc:TKCodeLangResource OriginalImagesLabel}" />
                                        <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource OriginalImagesHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <atom:ToggleSwitch Grid.Column="1" SizeType="Small" VerticalAlignment="Center" IsChecked="{Binding OriginalImages}" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource TKCode.Divider}" />
                                <!-- 提示缓存有效期 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Classes="strong" Text="{loc:TKCodeLangResource CacheTtlLabel}" />
                                        <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource CacheTtlHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
                                        <motion:IndicatorPanel IndicatorBrush="{DynamicResource TKCode.SegmentSelectedBg}" IndicatorBorderBrush="{DynamicResource TKCode.SegmentSelectedBorder}" IndicatorRadius="6">
                                        <ItemsControl ItemsSource="{Binding CacheTtls}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SettingsChoiceViewModel">
                                                    <Button Theme="{StaticResource TKCode.RowButton}" Classes.selected="{Binding IsSelected}" motion:IndicatorPanel.IsCurrent="{Binding IsSelected}" Content="{Binding Label}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.ChooseCacheTtlCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </motion:IndicatorPanel>
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource TKCode.Divider}" />
                                <!-- Agent 的 bash 工具使用的 shell -->
                                <views:ShellPickerView DataContext="{Binding AgentShell}" />
                                <Border Height="1" Background="{DynamicResource TKCode.Divider}" />
                                <!-- 新建终端默认使用的 shell -->
                                <views:ShellPickerView DataContext="{Binding TerminalShell}" />
                            </StackPanel>
                        </Border>

                        <!-- 模型目录：手动检查更新 → 查看差异 → 应用 -->
                        <Border Classes="card" Padding="16,12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="strong" Text="{loc:TKCodeLangResource CatalogTitle}" />
                                        <TextBlock Classes="secondary" Text="{Binding CatalogSourceText}" FontSize="12" />
                                        <TextBlock Classes="tertiary" Text="{Binding CatalogCountsText}" />
                                    </StackPanel>
                                    <atom:Button Grid.Column="1" SizeType="Small" Color="Default" Variant="Outlined" VerticalAlignment="Center"
                                                 Command="{Binding CheckCatalogCommand}" IsLoading="{Binding IsCheckingCatalog}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <icons:LucideIcon Kind="RefreshCw" Width="12" Height="12" />
                                            <TextBlock Text="{loc:TKCodeLangResource CheckForUpdates}" FontSize="12" />
                                        </StackPanel>
                                    </atom:Button>
                                </Grid>
                                <TextBlock Text="{Binding CatalogErrorText}" FontSize="12" Foreground="{DynamicResource TKCode.Danger}" TextWrapping="Wrap"
                                           IsVisible="{Binding HasCatalogError}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsUpToDate}">
                                    <icons:LucideIcon Kind="Check" Width="13" Height="13" StrokeBrush="{DynamicResource TKCode.Success}" />
                                    <TextBlock Text="{loc:TKCodeLangResource CatalogUpToDate}" FontSize="12" Foreground="{DynamicResource TKCode.Success}" />
                                </StackPanel>
                                <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource CatalogHint}" TextWrapping="Wrap" />

                                <!-- 待应用的更新：差异 -->
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource TKCode.Accent}" Padding="12,10" Margin="0,4,0,0"
                                        IsVisible="{Binding HasPendingUpdate}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Classes="strong" Text="{loc:TKCodeLangResource CatalogUpdateTitle}" />
                                                <TextBlock Classes="secondary" Text="{Binding UpdateSummaryText}" FontSize="12" />
                                            </StackPanel>
                                            <atom:Button Grid.Column="1" SizeType="Small" Color="Default" Variant="Text" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Command="{Binding DiscardCatalogUpdateCommand}" Content="{loc:TKCodeLangResource Discard}" />
                                            <atom:Button Grid.Column="2" SizeType="Small" Color="Default" Variant="Solid" VerticalAlignment="Center"
                                                         Command="{Binding ApplyCatalogUpdateCommand}" Content="{loc:TKCodeLangResource ApplyUpdate}" />
                                        </Grid>
                                        <atom:CheckBox IsChecked="{Binding ShowOnlyConfiguredChanges, Mode=TwoWay}" Content="{loc:TKCodeLangResource OnlyConfiguredProviders}" />
                                        <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource NoRelevantChanges}" FontSize="12" IsVisible="{Binding HasNoVisibleChanges}" />
                                        <ScrollViewer MaxHeight="420" atom:ScrollViewer.IsLiteMode="True">
                                            <ItemsControl ItemsSource="{Binding CatalogChanges}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CatalogProviderChangeItemViewModel">
                                                        <StackPanel Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <icons:ProviderLogo Key="{Binding LogoKey}" Width="14" Height="14" VerticalAlignment="Center" />
                                                                <TextBlock Classes="strong" Text="{Binding Name}" VerticalAlignment="Center" />
                                                                <Border Background="{DynamicResource TKCode.KbdBg}" CornerRadius="4" Padding="5,0" VerticalAlignment="Center">
                                                                    <TextBlock Classes="tertiary" Text="{Binding KindText}" FontSize="11" />
                                                                </Border>
                                                                <TextBlock Classes="tertiary" Text="{Binding SummaryText}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <ItemsControl ItemsSource="{Binding Changes}" Margin="22,0,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:CatalogFieldChangeItemViewModel">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <TextBlock Classes="tertiary" Text="{Binding Label}" />
                                                                            <TextBlock Classes="tertiary" Text="{Binding OldText}" TextDecorations="Strikethrough" />
                                                                            <TextBlock Classes="tertiary" Text="→" />
                                                                            <TextBlock Text="{Binding NewText}" FontSize="12" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <ItemsControl ItemsSource="{Binding Models}" Margin="22,0,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:CatalogModelChangeItemViewModel">
                                                                        <StackPanel Margin="0,2">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <TextBlock Text="+" FontWeight="Bold" Foreground="{DynamicResource TKCode.Success}" IsVisible="{Binding IsAdded}" />
                                                                                <TextBlock Text="−" FontWeight="Bold" Foreground="{DynamicResource TKCode.Danger}" IsVisible="{Binding IsRemoved}" />
                                                                                <TextBlock Text="~" FontWeight="Bold" Foreground="{DynamicResource TKCode.GitModified}" IsVisible="{Binding IsChanged}" />
                                                                                <TextBlock Text="{Binding Name}" FontSize="12" />
                                                                                <TextBlock Classes="tertiary" Text="{Binding Id}" FontFamily="{StaticResource TKCode.MonoFont}" IsVisible="{Binding ShowId}" />
                                                                            </StackPanel>
                                                                            <ItemsControl ItemsSource="{Binding Changes}" Margin="18,0,0,0">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:CatalogFieldChangeItemViewModel">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                            <TextBlock Classes="tertiary" Text="{Binding Label}" />
                                                                                            <TextBlock Classes="tertiary" Text="{Binding OldText}" TextDecorations="Strikethrough" />
                                                                                            <TextBlock Classes="tertiary" Text="→" />
                                                                                            <TextBlock Text="{Binding NewText}" FontSize="12" />
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Classes="tertiary" Text="{Binding MoreText}" Margin="22,0,0,0" IsVisible="{Binding HasMore}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 配置文件 -->
                        <Border Classes="card" Padding="16,12">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="strong" Text="{loc:TKCodeLangResource SettingsFileLabel}" />
                                <SelectableTextBlock Text="{Binding SettingsPath}" FontFamily="{StaticResource TKCode.MonoFont}" FontSize="12"
                                                     Foreground="{DynamicResource TKCode.TextSecondary}" />
                                <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource SettingsFileHint}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <atom:Button SizeType="Small" Color="Default" Variant="Outlined" Command="{Binding OpenSettingsFileCommand}"
                                                 Content="{loc:TKCodeLangResource OpenInEditor}" />
                                    <atom:Button SizeType="Small" Color="Default" Variant="Text" Command="{Binding RevealSettingsFileCommand}"
                                                 Content="{loc:TKCodeLangResource RevealInFolder}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 智能体（外部运行时，自动检测） ========== -->
                    <StackPanel Spacing="14" motion:Presence.IsPresent="{Binding IsAgents}" motion:Presence.Effect="SlideUp" motion:Presence.AnimateExit="False">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:TKCodeLangResource SettingsAgents}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource AgentsHint}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                        <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource NoRuntimes}" IsVisible="{Binding HasNoRuntimes}" />
                        <ItemsControl ItemsSource="{Binding InstalledRuntimes}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuntimeItemViewModel">
                                    <Border Classes="card" Padding="16,12">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <icons:ProviderLogo Key="{Binding LogoKey}" Width="24" Height="24" VerticalAlignment="Top" Margin="0,2,12,0" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Classes="strong" Text="{Binding Name}" />
                                                    <TextBlock Classes="tertiary" Text="{Binding Id}" FontFamily="{StaticResource TKCode.MonoFont}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Classes="secondary" Text="{Binding VersionText}" FontSize="12" IsVisible="{Binding HasVersion}" />
                                                    <TextBlock Classes="secondary" Text="{Binding AuthText}" FontSize="12" IsVisible="{Binding HasAuth}" />
                                                    <TextBlock Classes="secondary" Text="{Binding ModelsText}" FontSize="12" />
                                                </StackPanel>
                                                <TextBlock Classes="tertiary" Text="{Binding Dto.ExecutablePath}" FontFamily="{StaticResource TKCode.MonoFont}"
                                                           TextTrimming="CharacterEllipsis" IsVisible="{Binding HasPath}" />
                                                <TextBlock Text="{Binding Dto.Error}" FontSize="12" Foreground="{DynamicResource TKCode.Danger}" TextWrapping="Wrap"
                                                           IsVisible="{Binding HasError}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Background="{DynamicResource TKCode.MenuInputBg}" VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource TKCode.Success}" IsVisible="{Binding IsReady}" />
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource TKCode.Danger}" IsVisible="{Binding IsError}" />
                                                    <TextBlock Classes="secondary" Text="{Binding StatusText}" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 未安装：默认折叠 -->
                        <StackPanel Spacing="6" IsVisible="{Binding HasMissingRuntimes}">
                            <Button Theme="{StaticResource TKCode.ChipButton}" Command="{Binding ToggleMissingRuntimesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:LucideIcon Kind="ChevronRight" Width="11" Height="11" IsVisible="{Binding !ShowMissingRuntimes}" />
                                    <icons:LucideIcon Kind="ChevronDown" Width="11" Height="11" IsVisible="{Binding ShowMissingRuntimes}" />
                                    <TextBlock Text="{Binding MissingRuntimesTitle}" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding MissingRuntimes}" IsVisible="{Binding ShowMissingRuntimes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RuntimeItemViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,4">
                                            <icons:ProviderLogo Key="{Binding LogoKey}" Width="16" Height="16" Opacity="0.6" />
                                            <TextBlock Classes="secondary" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Classes="tertiary" Text="{Binding Id}" FontFamily="{StaticResource TKCode.MonoFont}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========== 命令、Skills 与模式（docs/design/composer.md §14） ========== -->
                    <StackPanel Spacing="10" DataContext="{Binding Assets}" x:DataType="vm:AssetsSettingsViewModel"
                                motion:Presence.IsPresent="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.IsAssets}"
                                motion:Presence.Effect="SlideUp" motion:Presence.AnimateExit="False">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:TKCodeLangResource SettingsAssets}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource AssetsHint}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                        <Border Classes="card">
                            <StackPanel>
                                <!-- 默认模式 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="strong" Text="{loc:TKCodeLangResource DefaultRoleLabel}" />
                                        <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource DefaultRoleHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="segmented" Margin="16,0,0,0">
                                        <motion:IndicatorPanel IndicatorBrush="{DynamicResource TKCode.SegmentSelectedBg}" IndicatorBorderBrush="{DynamicResource TKCode.SegmentSelectedBorder}" IndicatorRadius="6">
                                        <ItemsControl ItemsSource="{Binding DefaultRoles}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SettingsChoiceViewModel">
                                                    <Button Theme="{StaticResource TKCode.RowButton}" Classes.selected="{Binding IsSelected}" motion:IndicatorPanel.IsCurrent="{Binding IsSelected}" Content="{Binding Label}"
                                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.Assets.ChooseDefaultRoleCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </motion:IndicatorPanel>
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource TKCode.Divider}" />
                                <!-- 目录 -->
                                <StackPanel Spacing="4" Margin="16,12">
                                    <TextBlock Classes="strong" Text="{loc:TKCodeLangResource AssetsDirectories}" />
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="secondary" FontSize="12" Width="48" Text="{loc:TKCodeLangResource AssetsGlobalDirectory}" />
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding GlobalDirectory}" FontFamily="{StaticResource TKCode.MonoFont}" FontSize="12"
                                                             Foreground="{DynamicResource TKCode.TextSecondary}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Classes="secondary" FontSize="12" Width="48" Text="{loc:TKCodeLangResource AssetsProjectDirectory}" />
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding ProjectDirectory}" FontFamily="{StaticResource TKCode.MonoFont}" FontSize="12"
                                                             Foreground="{DynamicResource TKCode.TextSecondary}" IsVisible="{Binding HasProject}" />
                                        <TextBlock Grid.Column="1" Classes="tertiary" FontSize="12" Text="{loc:TKCodeLangResource AssetsNoProject}" IsVisible="{Binding !HasProject}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,6,0,0">
                            <TextBlock Classes="strong" Text="{loc:TKCodeLangResource AssetsCommandsTitle}" VerticalAlignment="Center" />
                            <atom:Button Grid.Column="1" SizeType="Small" Color="Default" Variant="Text" Command="{Binding CreateCommand}" CommandParameter="command|global"
                                         Content="{loc:TKCodeLangResource AssetsNewGlobal}" />
                            <atom:Button Grid.Column="2" SizeType="Small" Color="Default" Variant="Text" Command="{Binding CreateCommand}" CommandParameter="command|project"
                                         Content="{loc:TKCodeLangResource AssetsNewProject}" IsEnabled="{Binding HasProject}" />
                        </Grid>
                        <Border Classes="card">
                            <Panel>
                                <TextBlock Classes="tertiary" Margin="16,12" Text="{loc:TKCodeLangResource AssetsEmpty}" IsVisible="{Binding HasNoCommands}" />
                                <ItemsControl ItemsSource="{Binding Commands}" ItemTemplate="{StaticResource AssetItemTemplate}" />
                            </Panel>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,6,0,0">
                            <TextBlock Classes="strong" Text="{loc:TKCodeLangResource AssetsSkillsTitle}" VerticalAlignment="Center" />
                            <atom:Button Grid.Column="1" SizeType="Small" Color="Default" Variant="Text" Command="{Binding CreateCommand}" CommandParameter="skill|global"
                                         Content="{loc:TKCodeLangResource AssetsNewGlobal}" />
                            <atom:Button Grid.Column="2" SizeType="Small" Color="Default" Variant="Text" Command="{Binding CreateCommand}" CommandParameter="skill|project"
                                         Content="{loc:TKCodeLangResource AssetsNewProject}" IsEnabled="{Binding HasProject}" />
                        </Grid>
                        <Border Classes="card">
                            <Panel>
                                <TextBlock Classes="tertiary" Margin="16,12" Text="{loc:TKCodeLangResource AssetsEmpty}" IsVisible="{Binding HasNoSkills}" />
                                <ItemsControl ItemsSource="{Binding Skills}" ItemTemplate="{StaticResource AssetItemTemplate}" />
                            </Panel>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,6,0,0">
                            <TextBlock Classes="strong" Text="{loc:TKCodeLangResource AssetsRolesTitle}" VerticalAlignment="Center" />
                            <atom:Button Grid.Column="1" SizeType="Small" Color="Default" Variant="Text" Command="{Binding CreateCommand}" CommandParameter="role|global"
                                         Content="{loc:TKCodeLangResource AssetsNewGlobal}" />
                            <atom:Button Grid.Column="2" SizeType="Small" Color="Default" Variant="Text" Command="{Binding CreateCommand}" CommandParameter="role|project"
                                         Content="{loc:TKCodeLangResource AssetsNewProject}" IsEnabled="{Binding HasProject}" />
                        </Grid>
                        <Border Classes="card">
                            <Panel>
                                <TextBlock Classes="tertiary" Margin="16,12" Text="{loc:TKCodeLangResource AssetsEmpty}" IsVisible="{Binding HasNoRoles}" />
                                <ItemsControl ItemsSource="{Binding Roles}" ItemTemplate="{StaticResource AssetItemTemplate}" />
                            </Panel>
                        </Border>
                        <!-- 被覆盖的项与解析问题 -->
                        <StackPanel Spacing="6" IsVisible="{Binding HasNotices}" Margin="0,6,0,0">
                            <TextBlock Classes="strong" Text="{loc:TKCodeLangResource AssetsNoticesTitle}" Margin="2,0,0,0" />
                            <Border Classes="card">
                                <ItemsControl ItemsSource="{Binding Notices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AssetNoticeViewModel">
                                            <Button Theme="{StaticResource TKCode.RowButton}" Padding="16,8" MinHeight="0"
                                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Settings.Assets.OpenNoticeCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="{Binding Path}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <icons:LucideIcon Kind="CircleAlert" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,8,0"
                                                                      StrokeBrush="{DynamicResource TKCode.GitModified}" />
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Text}" />
                                                        <TextBlock Classes="tertiary" FontSize="11" FontFamily="{StaticResource TKCode.MonoFont}" Text="{Binding Path}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========== 关于 ========== -->
                    <StackPanel Spacing="16" motion:Presence.IsPresent="{Binding IsAbout}" motion:Presence.Effect="SlideUp" motion:Presence.AnimateExit="False">
                        <TextBlock Text="{loc:TKCodeLangResource SettingsAbout}" FontSize="20" FontWeight="SemiBold" />
                        <Border Classes="card" Padding="16,14">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="strong" Text="TKCode" FontSize="15" />
                                <TextBlock Classes="secondary" Text="{Binding VersionText}" />
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource AboutDataDir}" />
                                    <SelectableTextBlock Text="{Binding DataDirectory}" FontFamily="{StaticResource TKCode.MonoFont}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Classes="secondary" Text="{Binding CatalogText}" TextWrapping="Wrap" />
                                <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource AboutIcons}" TextWrapping="Wrap" />
                                <TextBlock Classes="secondary" Text="{loc:TKCodeLangResource AboutUi}" />
                            </StackPanel>
                        </Border>

                        <!-- 更新（docs/design/auto-update.md §9）：通道、自动检查、手动检查、更新说明（StreamMark 渲染） -->
                        <StackPanel Spacing="10" DataContext="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Updates}" x:DataType="vm:UpdatesViewModel">
                            <TextBlock Classes="strong" Text="{loc:TKCodeLangResource UpdateSectionTitle}" FontSize="15" Margin="0,8,0,0" />
                            <Border Classes="card">
                                <StackPanel>
                                    <!-- 当前版本 + 检查 -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="strong" Text="{Binding CurrentVersionText}" />
                                            <TextBlock Classes="tertiary" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <atom:Button Color="Default" Variant="Solid" SizeType="Small" Command="{Binding DownloadCommand}"
                                                         Content="{loc:TKCodeLangResource UpdateAction}" IsVisible="{Binding ShowDownloadButton}" />
                                            <atom:Button Color="Default" Variant="Solid" SizeType="Small" Command="{Binding OpenReleasePageCommand}"
                                                         Content="{loc:TKCodeLangResource UpdateOpenPage}" IsVisible="{Binding ShowOpenPageButton}" />
                                            <atom:Button Color="Default" Variant="Solid" SizeType="Small" Command="{Binding InstallCommand}"
                                                         Content="{loc:TKCodeLangResource UpdateInstallRestart}" IsVisible="{Binding ShowInstallButton}" />
                                            <atom:Button Color="Default" Variant="Outlined" SizeType="Small" Command="{Binding CheckNowCommand}"
                                                         Content="{loc:TKCodeLangResource UpdateCheckNow}" IsEnabled="{Binding !IsChecking}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource TKCode.Divider}" />
                                    <!-- 接收预发布版本 -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="strong" Text="{loc:TKCodeLangResource UpdatePrereleaseLabel}" />
                                            <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource UpdatePrereleaseHint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <atom:ToggleSwitch Grid.Column="1" SizeType="Small" VerticalAlignment="Center" IsChecked="{Binding IsReceivingPrereleases}" />
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource TKCode.Divider}" />
                                    <!-- 自动检查 -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="16,12">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="strong" Text="{loc:TKCodeLangResource UpdateAutoCheckLabel}" />
                                            <TextBlock Classes="tertiary" Text="{loc:TKCodeLangResource UpdateAutoCheckHint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <atom:ToggleSwitch Grid.Column="1" SizeType="Small" VerticalAlignment="Center" IsChecked="{Binding IsAutoCheck}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- 更新说明：Release 正文，用 StreamMark 渲染 -->
                            <Border Classes="card" Padding="16,12" IsVisible="{Binding HasNotes}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="strong" Text="{Binding NotesTitle}" VerticalAlignment="Center" />
                                        <atom:Button Grid.Column="1" Color="Default" Variant="Text" SizeType="Small" Command="{Binding OpenReleasePageCommand}"
                                                     Content="{loc:TKCodeLangResource UpdateViewOnGitHub}">
                                            <atom:Button.Icon><icons:LucideIcon Kind="ExternalLink" /></atom:Button.Icon>
                                        </atom:Button>
                                    </Grid>
                                    <smv:MarkdownView Markdown="{Binding Notes}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </Panel>
        </DockPanel>
    </Grid>
</UserControl>
