<!--
  TKCode 专属调色板：AtomUI Token 覆盖不到的界面表面（侧栏、Composer、磁贴等）。
  AtomUI 会根据当前主题设置 Application.RequestedThemeVariant，这里的 ThemeDictionaries 随之切换。
  暗色取值来自参考截图像素采样。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TKCode.WindowBg" Color="#141414" />
            <SolidColorBrush x:Key="TKCode.SidebarBg" Color="#1A1B1B" />
            <SolidColorBrush x:Key="TKCode.Divider" Color="#2B2C2D" />
            <SolidColorBrush x:Key="TKCode.HoverBg" Color="#222323" />
            <SolidColorBrush x:Key="TKCode.SelectedBg" Color="#272828" />
            <SolidColorBrush x:Key="TKCode.ComposerBg" Color="#1B1B1B" />
            <SolidColorBrush x:Key="TKCode.ComposerBorder" Color="#353535" />
            <SolidColorBrush x:Key="TKCode.PopupBg" Color="#181818" />
            <SolidColorBrush x:Key="TKCode.PopupBorder" Color="#383838" />
            <SolidColorBrush x:Key="TKCode.InputBg" Color="#1E1E1E" />
            <SolidColorBrush x:Key="TKCode.InputBorder" Color="#3D3D3D" />
            <SolidColorBrush x:Key="TKCode.PillBorder" Color="#363636" />
            <SolidColorBrush x:Key="TKCode.TileBorder" Color="#2B2B2B" />
            <SolidColorBrush x:Key="TKCode.TileHoverBg" Color="#262627" />
            <SolidColorBrush x:Key="TKCode.TileHoverBorder" Color="#424243" />
            <SolidColorBrush x:Key="TKCode.TabActiveBg" Color="#262626" />
            <SolidColorBrush x:Key="TKCode.AccentBg" Color="#F0F0F0" />
            <SolidColorBrush x:Key="TKCode.AccentFg" Color="#151515" />
            <SolidColorBrush x:Key="TKCode.TextPrimary" Color="#F0F0F0" />
            <SolidColorBrush x:Key="TKCode.TextSecondary" Color="#9A9A9A" />
            <SolidColorBrush x:Key="TKCode.TextTertiary" Color="#6E6E6E" />
            <SolidColorBrush x:Key="TKCode.UserBubbleBg" Color="#212121" />
            <SolidColorBrush x:Key="TKCode.CardBg" Color="#1A1A1A" />
            <SolidColorBrush x:Key="TKCode.CodeBg" Color="#1C1C1C" />
            <SolidColorBrush x:Key="TKCode.Success" Color="#40A167" />
            <SolidColorBrush x:Key="TKCode.Danger" Color="#E5534B" />
            <SolidColorBrush x:Key="TKCode.DangerBorder" Color="#55E5534B" />
            <SolidColorBrush x:Key="TKCode.DiffAddBg" Color="#1F3B2B" />
            <SolidColorBrush x:Key="TKCode.DiffRemoveBg" Color="#3E2427" />
            <SolidColorBrush x:Key="TKCode.DiffHunkBg" Color="#222222" />
            <SolidColorBrush x:Key="TKCode.GitUntracked" Color="#84B8C8" />
            <SolidColorBrush x:Key="TKCode.GitModified" Color="#D7BA7D" />
            <SolidColorBrush x:Key="TKCode.Accent" Color="#8B7CF6" />
            <SolidColorBrush x:Key="TKCode.AccentSoftBg" Color="#2E2A4A" />
            <SolidColorBrush x:Key="TKCode.AccentText" Color="#B4A9FF" />
            <!-- StreamMark：行内代码紫色字 + 紫色浅底，列表圆点 / 序号紫色 -->
            <SolidColorBrush x:Key="Md.InlineCodeForeground" Color="#B4A9FF" />
            <SolidColorBrush x:Key="Md.InlineCodeBackground" Color="#2E2A4A" />
            <SolidColorBrush x:Key="Md.ListMarkerForeground" Color="#8B7CF6" />
            <SolidColorBrush x:Key="TKCode.MenuBg" Color="#1C1C1E" />
            <SolidColorBrush x:Key="TKCode.MenuBorder" Color="#2F2F31" />
            <SolidColorBrush x:Key="TKCode.MenuItemHoverBg" Color="#2A2A2C" />
            <SolidColorBrush x:Key="TKCode.MenuInputBg" Color="#232325" />
            <SolidColorBrush x:Key="TKCode.KbdBg" Color="#2C2C2E" />
            <SolidColorBrush x:Key="TKCode.KbdFg" Color="#A0A0A3" />
            <SolidColorBrush x:Key="TKCode.RingTrack" Color="#333335" />
            <SolidColorBrush x:Key="TKCode.UserBubble" Color="#262627" />
            <SolidColorBrush x:Key="TKCode.SegmentSelectedBg" Color="#333335" />
            <SolidColorBrush x:Key="TKCode.FileBlue" Color="#5AA2F0" />
            <SolidColorBrush x:Key="TKCode.FileYellow" Color="#E2C05C" />
            <SolidColorBrush x:Key="TKCode.FilePurple" Color="#A88BF0" />
            <SolidColorBrush x:Key="TKCode.FileRed" Color="#E8645A" />
            <SolidColorBrush x:Key="TKCode.FileGreen" Color="#5EBE84" />
            <SolidColorBrush x:Key="TKCode.FileOrange" Color="#E8915A" />
            <SolidColorBrush x:Key="TKCode.FileGray" Color="#9A9A9A" />
            <SolidColorBrush x:Key="TKCode.LineNumber" Color="#5C5C5E" />
            <SolidColorBrush x:Key="TKCode.SegmentSelectedBorder" Color="#404043" />
            <SolidColorBrush x:Key="TKCode.BadgeBg" Color="#3A4150" />
            <SolidColorBrush x:Key="TKCode.BadgeFg" Color="#C9D1E0" />
            <SolidColorBrush x:Key="TKCode.TreeLine" Color="#3A3A3C" />
            <!-- 上下文容量的分类色：颜色跟着类别走；按叠放顺序（提示词→工具→MCP→技能→消息）校验过相邻对的色觉差异，“其他”用中性灰 -->
            <SolidColorBrush x:Key="TKCode.ContextSystemPrompt" Color="#9085E9" />
            <SolidColorBrush x:Key="TKCode.ContextSystemTools" Color="#D95926" />
            <SolidColorBrush x:Key="TKCode.ContextMcpTools" Color="#199E70" />
            <SolidColorBrush x:Key="TKCode.ContextSkills" Color="#C98500" />
            <SolidColorBrush x:Key="TKCode.ContextMessages" Color="#3987E5" />
            <SolidColorBrush x:Key="TKCode.ContextOther" Color="#6E6E72" />
            <!-- 背景光晕：主区顶部偏右的灰白光、左侧的暗绿光；侧栏左下的冷色光 -->
            <RadialGradientBrush x:Key="TKCode.GlowMain" Center="62%,22%" GradientOrigin="62%,22%" RadiusX="42%" RadiusY="34%">
                <GradientStop Offset="0" Color="#1CFFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="TKCode.GlowAccent" Center="18%,30%" GradientOrigin="18%,30%" RadiusX="30%" RadiusY="30%">
                <GradientStop Offset="0" Color="#1A2FB36B" />
                <GradientStop Offset="1" Color="#002FB36B" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="TKCode.GlowSidebar" Center="0%,100%" GradientOrigin="0%,100%" RadiusX="90%" RadiusY="45%">
                <GradientStop Offset="0" Color="#1A4A7BA8" />
                <GradientStop Offset="1" Color="#004A7BA8" />
            </RadialGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TKCode.WindowBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TKCode.SidebarBg" Color="#F7F7F7" />
            <SolidColorBrush x:Key="TKCode.Divider" Color="#E6E6E6" />
            <SolidColorBrush x:Key="TKCode.HoverBg" Color="#EFEFEF" />
            <SolidColorBrush x:Key="TKCode.SelectedBg" Color="#E9E9E9" />
            <SolidColorBrush x:Key="TKCode.ComposerBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TKCode.ComposerBorder" Color="#D9D9D9" />
            <SolidColorBrush x:Key="TKCode.PopupBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TKCode.PopupBorder" Color="#E0E0E0" />
            <SolidColorBrush x:Key="TKCode.InputBg" Color="#F7F7F7" />
            <SolidColorBrush x:Key="TKCode.InputBorder" Color="#DEDEDE" />
            <SolidColorBrush x:Key="TKCode.PillBorder" Color="#DEDEDE" />
            <SolidColorBrush x:Key="TKCode.TileBorder" Color="#E6E6E6" />
            <SolidColorBrush x:Key="TKCode.TileHoverBg" Color="#F4F4F4" />
            <SolidColorBrush x:Key="TKCode.TileHoverBorder" Color="#D0D0D0" />
            <SolidColorBrush x:Key="TKCode.TabActiveBg" Color="#EDEDED" />
            <SolidColorBrush x:Key="TKCode.AccentBg" Color="#1A1A1A" />
            <SolidColorBrush x:Key="TKCode.AccentFg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TKCode.TextPrimary" Color="#1A1A1A" />
            <SolidColorBrush x:Key="TKCode.TextSecondary" Color="#6B6B6B" />
            <SolidColorBrush x:Key="TKCode.TextTertiary" Color="#9B9B9B" />
            <SolidColorBrush x:Key="TKCode.UserBubbleBg" Color="#F2F2F2" />
            <SolidColorBrush x:Key="TKCode.CardBg" Color="#FAFAFA" />
            <SolidColorBrush x:Key="TKCode.CodeBg" Color="#F5F5F5" />
            <SolidColorBrush x:Key="TKCode.Success" Color="#2F9E5C" />
            <SolidColorBrush x:Key="TKCode.Danger" Color="#D1362F" />
            <SolidColorBrush x:Key="TKCode.DangerBorder" Color="#55D1362F" />
            <SolidColorBrush x:Key="TKCode.DiffAddBg" Color="#E3F4EA" />
            <SolidColorBrush x:Key="TKCode.DiffRemoveBg" Color="#FBE6E4" />
            <SolidColorBrush x:Key="TKCode.DiffHunkBg" Color="#EFEFF1" />
            <SolidColorBrush x:Key="TKCode.GitUntracked" Color="#2B7A92" />
            <SolidColorBrush x:Key="TKCode.GitModified" Color="#9A6B00" />
            <SolidColorBrush x:Key="TKCode.Accent" Color="#6E5BEF" />
            <SolidColorBrush x:Key="TKCode.AccentSoftBg" Color="#ECE9FE" />
            <SolidColorBrush x:Key="TKCode.AccentText" Color="#5A46D6" />
            <!-- StreamMark：行内代码紫色字 + 紫色浅底，列表圆点 / 序号紫色 -->
            <SolidColorBrush x:Key="Md.InlineCodeForeground" Color="#5A46D6" />
            <SolidColorBrush x:Key="Md.InlineCodeBackground" Color="#ECE9FE" />
            <SolidColorBrush x:Key="Md.ListMarkerForeground" Color="#6E5BEF" />
            <SolidColorBrush x:Key="TKCode.MenuBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TKCode.MenuBorder" Color="#E3E3E6" />
            <SolidColorBrush x:Key="TKCode.MenuItemHoverBg" Color="#EFEFF1" />
            <SolidColorBrush x:Key="TKCode.MenuInputBg" Color="#F4F4F5" />
            <SolidColorBrush x:Key="TKCode.KbdBg" Color="#EDEDEF" />
            <SolidColorBrush x:Key="TKCode.KbdFg" Color="#6B6B70" />
            <SolidColorBrush x:Key="TKCode.RingTrack" Color="#E2E2E5" />
            <SolidColorBrush x:Key="TKCode.UserBubble" Color="#F0F0F1" />
            <SolidColorBrush x:Key="TKCode.SegmentSelectedBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TKCode.FileBlue" Color="#2F7BD6" />
            <SolidColorBrush x:Key="TKCode.FileYellow" Color="#B58A10" />
            <SolidColorBrush x:Key="TKCode.FilePurple" Color="#7A55D6" />
            <SolidColorBrush x:Key="TKCode.FileRed" Color="#D1453B" />
            <SolidColorBrush x:Key="TKCode.FileGreen" Color="#2E9A5A" />
            <SolidColorBrush x:Key="TKCode.FileOrange" Color="#C8682C" />
            <SolidColorBrush x:Key="TKCode.FileGray" Color="#7A7A7E" />
            <SolidColorBrush x:Key="TKCode.LineNumber" Color="#A8A8AC" />
            <SolidColorBrush x:Key="TKCode.SegmentSelectedBorder" Color="#DADADD" />
            <SolidColorBrush x:Key="TKCode.BadgeBg" Color="#DCE2EC" />
            <SolidColorBrush x:Key="TKCode.BadgeFg" Color="#3A4458" />
            <SolidColorBrush x:Key="TKCode.TreeLine" Color="#DADADD" />
            <!-- 上下文容量的分类色：颜色跟着类别走；按叠放顺序（提示词→工具→MCP→技能→消息）校验过相邻对的色觉差异，“其他”用中性灰 -->
            <SolidColorBrush x:Key="TKCode.ContextSystemPrompt" Color="#6250D6" />
            <SolidColorBrush x:Key="TKCode.ContextSystemTools" Color="#EB6834" />
            <SolidColorBrush x:Key="TKCode.ContextMcpTools" Color="#1BAF7A" />
            <SolidColorBrush x:Key="TKCode.ContextSkills" Color="#EDA100" />
            <SolidColorBrush x:Key="TKCode.ContextMessages" Color="#2A78D6" />
            <SolidColorBrush x:Key="TKCode.ContextOther" Color="#A8A8AC" />
            <RadialGradientBrush x:Key="TKCode.GlowMain" Center="62%,22%" GradientOrigin="62%,22%" RadiusX="42%" RadiusY="34%">
                <GradientStop Offset="0" Color="#0A000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="TKCode.GlowAccent" Center="18%,30%" GradientOrigin="18%,30%" RadiusX="30%" RadiusY="30%">
                <GradientStop Offset="0" Color="#102FB36B" />
                <GradientStop Offset="1" Color="#002FB36B" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="TKCode.GlowSidebar" Center="0%,100%" GradientOrigin="0%,100%" RadiusX="90%" RadiusY="45%">
                <GradientStop Offset="0" Color="#104A7BA8" />
                <GradientStop Offset="1" Color="#004A7BA8" />
            </RadialGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- StreamMark 选区：与 Composer / SelectableTextBlock 同色，两套主题通用。
         不沿用 AtomUI 映射的 ColorPrimaryBgHover：主色是近黑 / 近白，亮色下推导出深灰，选中后黑底黑字 -->
    <SolidColorBrush x:Key="Md.SelectionBackground" Color="#553B82F6" />

    <CornerRadius x:Key="TKCode.RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="TKCode.RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="TKCode.RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="TKCode.RadiusMenu">10</CornerRadius>
    <BoxShadows x:Key="TKCode.MenuShadow">0 8 24 0 #66000000</BoxShadows>
    <!-- 浮在会话上方的小控件（任务球）：轻微投影，与正文区分开 -->
    <BoxShadows x:Key="TKCode.FloatShadow">0 2 10 0 #40000000</BoxShadows>
    <FontFamily x:Key="TKCode.MonoFont">Menlo, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>
    <x:Double x:Key="TKCode.FontSizeBody">13</x:Double>
    <x:Double x:Key="TKCode.FontSizeSmall">12</x:Double>
</ResourceDictionary>
