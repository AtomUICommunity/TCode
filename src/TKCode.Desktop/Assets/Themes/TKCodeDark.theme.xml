<?xml version="1.0" encoding="utf-8"?>
<!-- TKCode 暗色主题：近黑中性灰、低对比边框、白色作为唯一强调色（取色自参考截图） -->
<Theme xmlns="https://atomui.net/schemas/theme/v1" Id="TKCodeDark" Name="TKCode Dark" Appearance="Dark">
  <Algorithms>
    <Algorithm Id="Default" />
    <Algorithm Id="Dark" />
  </Algorithms>
  <Tokens>
    <!-- Seed -->
    <Token Name="ColorPrimary" Value="#F0F0F0" />
    <Token Name="ColorLink" Value="#B4B4B4" />
    <Token Name="ColorTextBase" Value="#F0F0F0" />
    <Token Name="FontSize" Value="13" />
    <Token Name="BorderRadius" Value="8" />
    <Token Name="ControlHeight" Value="30" />
    <!-- Map：显式指定表面色，避免暗色算法按亮度推导出偏差 -->
    <Token Name="ColorBgContainer" Value="#151515" />
    <Token Name="ColorBgLayout" Value="#151718" />
    <Token Name="ColorBgElevated" Value="#181818" />
    <Token Name="ColorBgSpotlight" Value="#2A2A2A" />
    <Token Name="ColorBorder" Value="#3A3A3A" />
    <Token Name="ColorBorderSecondary" Value="#2B2C2D" />
    <Token Name="FontSizeSM" Value="12" />
    <Token Name="FontHeightSM" Value="20" />
    <Token Name="RelativeLineHeightSM" Value="1.6667" />
    <Token Name="BorderRadiusLG" Value="12" />
    <Token Name="BorderRadiusSM" Value="6" />
    <!-- Alias：主色为白色，主色背景上的文字改为深色 -->
    <Token Name="ColorTextLightSolid" Value="#151515" />
  </Tokens>
  <Controls>
    <Control Catalog="AtomUI" Id="ToggleSwitch" Algorithm="Disabled">
      <Tokens>
        <Token Name="SwitchColor" Value="#40A167" />
      </Tokens>
    </Control>
  </Controls>
</Theme>
