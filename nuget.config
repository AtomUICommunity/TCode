<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- StreamMark 本地包：tools/streammark/pack.sh 从子模块 external/StreamMark 打包到这里 -->
    <add key="streammark-local" value="packages/streammark" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="streammark-local">
      <package pattern="StreamMark.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
