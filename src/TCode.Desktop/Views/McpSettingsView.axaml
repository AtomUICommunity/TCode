<!--
  设置 › MCP 服务器：主从双栏（docs/design/mcp.md §11）。
  左栏：搜索 + “全局 / 项目”两组服务器 + 添加；右栏：选中服务器的连接表单、状态、工具与日志。
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:motion="using:TCode.Desktop.Motion"
             xmlns:vm="using:TCode.Desktop.ViewModels"
             xmlns:icons="using:TCode.Desktop.Icons"
             xmlns:loc="using:TCode.Desktop.Localization"
             x:Class="TCode.Desktop.Views.McpSettingsView"
             x:DataType="vm:McpSettingsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.groupLabel">
            <Setter Property="Foreground" Value="{DynamicResource TCode.TextTertiary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="10,12,0,4" />
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{DynamicResource TCode.MenuInputBg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tag">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Background" Value="{DynamicResource TCode.MenuInputBg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="atom|TextArea.multiline">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="MinLines" Value="2" />
            <Setter Property="MaxLines" Value="8" />
            <Setter Property="FontFamily" Value="{StaticResource TCode.MonoFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <Panel>
    <Grid ColumnDefinitions="248,*" Margin="24,0,24,0">
        <!-- ======== 左栏：服务器列表 ======== -->
        <Border Classes="card" Margin="0,0,0,24">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="inputBox" Margin="8,8,8,0">
                    <Grid ColumnDefinitions="Auto,*" Margin="8,0,0,0">
                        <icons:LucideIcon Kind="Search" Width="13" Height="13" StrokeBrush="{DynamicResource TCode.TextTertiary}" />
                        <atom:LineEdit Grid.Column="1" StyleVariant="Borderless" Background="Transparent" SizeType="Small"
                                       PlaceholderText="{loc:TCodeLangResource SearchMcpServers}" Text="{Binding Search, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Margin="6">
                    <Button Theme="{StaticResource TCode.RowButton}" Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:LucideIcon Kind="Plus" Width="14" Height="14" />
                            <TextBlock Text="{loc:TCodeLangResource AddMcpServer}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid ColumnDefinitions="*,*">
                        <Button Theme="{StaticResource TCode.RowButton}" Command="{Binding OpenImportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <icons:LucideIcon Kind="Download" Width="14" Height="14" />
                                <TextBlock Text="{loc:TCodeLangResource ImportMcp}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Theme="{StaticResource TCode.RowButton}" Command="{Binding OpenExportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <icons:LucideIcon Kind="Upload" Width="14" Height="14" />
                                <TextBlock Text="{loc:TCodeLangResource ExportMcp}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource TCode.Divider}" />
                <ScrollViewer atom:ScrollViewer.IsLiteMode="True">
                    <StackPanel Margin="6,0,6,6">
                        <TextBlock Classes="groupLabel" Text="{loc:TCodeLangResource McpGlobalGroup}" />
                        <ItemsControl ItemsSource="{Binding GlobalServers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:McpServerItemViewModel">
                                    <Button Theme="{StaticResource TCode.RowButton}" Classes.selected="{Binding IsSelected}" MinHeight="32" Margin="0,1"
                                            Command="{Binding $parent[UserControl].((vm:McpSettingsViewModel)DataContext).SelectCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="{Binding StatusText}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <icons:LucideIcon Kind="Plug" Width="14" Height="14" StrokeBrush="{DynamicResource TCode.TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="tertiary" Text="{Binding ToolCountText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <Panel Grid.Column="3" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TCode.Success}" IsVisible="{Binding IsOk}" />
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TCode.GitModified}" IsVisible="{Binding IsBusy}" />
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TCode.GitModified}" IsVisible="{Binding IsWarn}" />
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TCode.Danger}" IsVisible="{Binding IsError}" />
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TCode.TextTertiary}" IsVisible="{Binding IsOff}" />
                                            </Panel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="tertiary" Text="{loc:TCodeLangResource McpNoServers}" TextWrapping="Wrap" Margin="10,4,10,0"
                                   IsVisible="{Binding HasNoServers}" />

                        <StackPanel IsVisible="{Binding HasProjectServers}">
                            <TextBlock Classes="groupLabel" Text="{Binding ProjectGroupTitle}" />
                            <ItemsControl ItemsSource="{Binding ProjectServers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:McpServerItemViewModel">
                                        <Button Theme="{StaticResource TCode.RowButton}" Classes.selected="{Binding IsSelected}" MinHeight="32" Margin="0,1"
                                                Command="{Binding $parent[UserControl].((vm:McpSettingsViewModel)DataContext).SelectCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="{Binding StatusText}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <icons:LucideIcon Kind="Folder" Width="14" Height="14" StrokeBrush="{DynamicResource TCode.TextSecondary}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Classes="tertiary" Text="{Binding ToolCountText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <Panel Grid.Column="3" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TCode.Success}" IsVisible="{Binding IsOk}" />
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TCode.GitModified}" IsVisible="{Binding IsBusy}" />
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TCode.GitModified}" IsVisible="{Binding IsWarn}" />
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TCode.Danger}" IsVisible="{Binding IsError}" />
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TCode.TextTertiary}" IsVisible="{Binding IsOff}" />
                                                </Panel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ======== 右栏 ======== -->
        <ScrollViewer Grid.Column="1" Margin="16,0,0,0" atom:ScrollViewer.IsLiteMode="True">
            <StackPanel MaxWidth="820" Spacing="14" Margin="0,0,16,24">
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:TCodeLangResource SettingsMcp}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Classes="secondary" Text="{loc:TCodeLangResource McpHint}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasProjectError}">
                    <icons:LucideIcon Kind="CircleAlert" Width="13" Height="13" StrokeBrush="{DynamicResource TCode.Danger}" />
                    <TextBlock Text="{Binding ProjectError}" FontSize="12" Foreground="{DynamicResource TCode.Danger}" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Classes="secondary" Text="{loc:TCodeLangResource SelectMcpHint}" Margin="0,40,0,0" HorizontalAlignment="Center"
                           IsVisible="{Binding ShowEmptyDetail}" />

                <ContentControl Content="{Binding Selected}" IsVisible="{Binding HasSelection}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:McpServerDetailViewModel">
                            <StackPanel Spacing="14">
                                <!-- 标题 -->
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                                    <icons:LucideIcon Kind="Plug" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Classes="pill" IsVisible="{Binding IsExisting}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource TCode.Success}" IsVisible="{Binding IsOk}" />
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource TCode.GitModified}" IsVisible="{Binding IsWarn}" />
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource TCode.Danger}" IsVisible="{Binding IsBad}" />
                                            <TextBlock Classes="secondary" Text="{Binding StatusText}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                    <atom:ToggleSwitch Grid.Column="4" SizeType="Small" VerticalAlignment="Center" IsVisible="{Binding IsExisting}"
                                                       IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding ToggleEnabledCommand}"
                                                       ToolTip.Tip="{loc:TCodeLangResource McpEnableServer}" />
                                    <atom:Button Grid.Column="5" Margin="8,0,0,0" Color="Default" Variant="Text" SizeType="Small" IsVisible="{Binding IsExisting}"
                                                 Command="{Binding RemoveCommand}" ToolTip.Tip="{loc:TCodeLangResource Remove}">
                                        <atom:Button.Icon><icons:LucideIcon Kind="Trash" /></atom:Button.Icon>
                                    </atom:Button>
                                </Grid>

                                <!-- 状态与操作 -->
                                <StackPanel Spacing="6" IsVisible="{Binding IsExisting}">
                                    <TextBlock Classes="tertiary" Text="{Binding ServerInfo}" IsVisible="{Binding HasServerInfo}" />
                                    <TextBlock Classes="tertiary" Text="{loc:TCodeLangResource McpShadowedHint}" IsVisible="{Binding ShadowedGlobal}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasStatusError}">
                                        <icons:LucideIcon Kind="CircleAlert" Width="13" Height="13" StrokeBrush="{DynamicResource TCode.Danger}" />
                                        <SelectableTextBlock Text="{Binding StatusError}" FontSize="12" Foreground="{DynamicResource TCode.Danger}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasMissingVariables}">
                                        <icons:LucideIcon Kind="CircleAlert" Width="13" Height="13" StrokeBrush="{DynamicResource TCode.GitModified}" />
                                        <TextBlock Text="{Binding MissingVariables}" FontSize="12" Foreground="{DynamicResource TCode.GitModified}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Classes="card" Padding="14,10" BorderBrush="{DynamicResource TCode.GitModified}" IsVisible="{Binding IsUntrusted}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{loc:TCodeLangResource McpUntrustedHint}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                                                <atom:Button Color="Default" Variant="Text" SizeType="Small" Command="{Binding IgnoreCommand}"
                                                             Content="{loc:TCodeLangResource McpIgnore}" />
                                                <atom:Button Color="Default" Variant="Solid" SizeType="Small" Command="{Binding TrustCommand}"
                                                             Content="{loc:TCodeLangResource McpTrust}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <atom:Button Color="Default" Variant="Outlined" SizeType="Small" Command="{Binding RestartCommand}" IsVisible="{Binding CanRestart}"
                                                     Content="{loc:TCodeLangResource McpRestart}">
                                            <atom:Button.Icon><icons:LucideIcon Kind="RefreshCw" /></atom:Button.Icon>
                                        </atom:Button>
                                        <atom:Button Color="Default" Variant="Solid" SizeType="Small" Command="{Binding LoginCommand}" IsVisible="{Binding NeedsLogin}"
                                                     Content="{loc:TCodeLangResource McpLogin}">
                                            <atom:Button.Icon><icons:LucideIcon Kind="LogIn" /></atom:Button.Icon>
                                        </atom:Button>
                                        <atom:Button Color="Default" Variant="Text" SizeType="Small" Command="{Binding LogoutCommand}" IsVisible="{Binding CanLogin}"
                                                     Content="{loc:TCodeLangResource McpLogout}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 连接 -->
                                <Border Classes="card" Padding="16,14">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="sectionTitle" Text="{loc:TCodeLangResource ConnectionLabel}" />
                                        <Grid ColumnDefinitions="100,*">
                                            <TextBlock Classes="secondary" Text="{loc:TCodeLangResource McpServerNameLabel}" VerticalAlignment="Center" />
                                            <atom:LineEdit Grid.Column="1" PlaceholderText="github" Text="{Binding NameInput, Mode=TwoWay}" FontFamily="{StaticResource TCode.MonoFont}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="100,*" IsVisible="{Binding CanChooseScope}">
                                            <TextBlock Classes="secondary" Text="{loc:TCodeLangResource McpScopeLabel}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Classes="segmented" HorizontalAlignment="Left">
                                                <motion:IndicatorPanel IndicatorBrush="{DynamicResource TCode.SegmentSelectedBg}" IndicatorBorderBrush="{DynamicResource TCode.SegmentSelectedBorder}" IndicatorRadius="6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Theme="{StaticResource TCode.RowButton}" Content="{loc:TCodeLangResource McpScopeGlobal}" Command="{Binding ChooseGlobalScopeCommand}"
                                                                Classes.selected="{Binding !IsProjectScope}" motion:IndicatorPanel.IsCurrent="{Binding !IsProjectScope}" />
                                                        <Button Theme="{StaticResource TCode.RowButton}" Content="{loc:TCodeLangResource McpScopeProject}" Command="{Binding ChooseProjectScopeCommand}"
                                                                Classes.selected="{Binding IsProjectScope}" motion:IndicatorPanel.IsCurrent="{Binding IsProjectScope}" />
                                                    </StackPanel>
                                                </motion:IndicatorPanel>
                                            </Border>
                                        </Grid>
                                        <Grid ColumnDefinitions="100,*">
                                            <TextBlock Classes="secondary" Text="{loc:TCodeLangResource McpTransportLabel}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Classes="segmented" HorizontalAlignment="Left">
                                                <motion:IndicatorPanel IndicatorBrush="{DynamicResource TCode.SegmentSelectedBg}" IndicatorBorderBrush="{DynamicResource TCode.SegmentSelectedBorder}" IndicatorRadius="6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Theme="{StaticResource TCode.RowButton}" Content="{loc:TCodeLangResource McpTransportLocal}" Command="{Binding ChooseLocalCommand}"
                                                                Classes.selected="{Binding IsLocal}" motion:IndicatorPanel.IsCurrent="{Binding IsLocal}" />
                                                        <Button Theme="{StaticResource TCode.RowButton}" Content="{loc:TCodeLangResource McpTransportRemote}" Command="{Binding ChooseRemoteCommand}"
                                                                Classes.selected="{Binding IsRemote}" motion:IndicatorPanel.IsCurrent="{Binding IsRemote}" />
                                                    </StackPanel>
                                                </motion:IndicatorPanel>
                                            </Border>
                                        </Grid>
                                        <!-- 本地命令 -->
                                        <StackPanel Spacing="12" IsVisible="{Binding IsLocal}">
                                            <Grid ColumnDefinitions="100,*">
                                                <TextBlock Classes="secondary" Text="{loc:TCodeLangResource McpCommandLabel}" VerticalAlignment="Center" />
                                                <atom:LineEdit Grid.Column="1" PlaceholderText="npx" Text="{Binding CommandInput, Mode=TwoWay}" FontFamily="{StaticResource TCode.MonoFont}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto">
                                                <TextBlock Classes="secondary" Text="{loc:TCodeLangResource McpArgsLabel}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                                <atom:TextArea Grid.Column="1" Classes="multiline" Text="{Binding ArgsInput, Mode=TwoWay}" PlaceholderText="-y&#x0a;@modelcontextprotocol/server-filesystem" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="tertiary" Text="{loc:TCodeLangResource McpArgsHint}" Margin="2,4,0,0" />
                                            </Grid>
                                            <Grid ColumnDefinitions="100,*">
                                                <TextBlock Classes="secondary" Text="{loc:TCodeLangResource McpCwdLabel}" VerticalAlignment="Center" />
                                                <atom:LineEdit Grid.Column="1" PlaceholderText="{loc:TCodeLangResource McpCwdPlaceholder}" Text="{Binding CwdInput, Mode=TwoWay}"
                                                               FontFamily="{StaticResource TCode.MonoFont}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto">
                                                <TextBlock Classes="secondary" Text="{loc:TCodeLangResource McpEnvLabel}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                                <atom:TextArea Grid.Column="1" Classes="multiline" Text="{Binding EnvInput, Mode=TwoWay}" PlaceholderText="API_KEY={env:MY_API_KEY}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="tertiary" Text="{loc:TCodeLangResource McpEnvHint}" TextWrapping="Wrap" Margin="2,4,0,0" />
                                            </Grid>
                                        </StackPanel>
                                        <!-- 远程 URL -->
                                        <StackPanel Spacing="12" IsVisible="{Binding IsRemote}">
                                            <Grid ColumnDefinitions="100,*">
                                                <TextBlock Classes="secondary" Text="{loc:TCodeLangResource McpUrlLabel}" VerticalAlignment="Center" />
                                                <atom:LineEdit Grid.Column="1" PlaceholderText="https://example.com/mcp" Text="{Binding UrlInput, Mode=TwoWay}"
                                                               FontFamily="{StaticResource TCode.MonoFont}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto">
                                                <TextBlock Classes="secondary" Text="{loc:TCodeLangResource McpHeadersLabel}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                                <atom:TextArea Grid.Column="1" Classes="multiline" Text="{Binding HeadersInput, Mode=TwoWay}" PlaceholderText="Authorization: Bearer {env:TOKEN}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="tertiary" Text="{loc:TCodeLangResource McpHeadersHint}" TextWrapping="Wrap" Margin="2,4,0,0" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource TCode.Danger}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                                        <Border Height="1" Background="{DynamicResource TCode.Divider}" Margin="-16,2" />
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <atom:Button Color="Default" Variant="Outlined" SizeType="Small" Command="{Binding TestCommand}" IsLoading="{Binding IsTesting}"
                                                         Content="{loc:TCodeLangResource TestConnection}" />
                                            <Panel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" IsVisible="{Binding HasTestResult}">
                                                <TextBlock Text="{Binding TestResult}" FontSize="12" Foreground="{DynamicResource TCode.Success}" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding TestSucceeded}" ToolTip.Tip="{Binding TestResult}" />
                                                <TextBlock Text="{Binding TestResult}" FontSize="12" Foreground="{DynamicResource TCode.Danger}" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding !TestSucceeded}" ToolTip.Tip="{Binding TestResult}" />
                                            </Panel>
                                            <TextBlock Grid.Column="2" Classes="tertiary" Text="{loc:TCodeLangResource Unsaved}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                       IsVisible="{Binding IsDirty}" />
                                            <atom:Button Grid.Column="3" Color="Default" Variant="Solid" SizeType="Small" Command="{Binding SaveCommand}"
                                                         Content="{loc:TCodeLangResource Save}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 服务器说明 -->
                                <Border Classes="card" Padding="16,14" IsVisible="{Binding HasInstructions}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="sectionTitle" Text="{loc:TCodeLangResource McpInstructionsLabel}" />
                                        <SelectableTextBlock Text="{Binding Instructions}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TCode.TextSecondary}" />
                                    </StackPanel>
                                </Border>

                                <!-- 工具 -->
                                <Border Classes="card" Padding="16,14" IsVisible="{Binding IsExisting}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Classes="sectionTitle" Text="{loc:TCodeLangResource McpToolsLabel}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Classes="tertiary" Text="{Binding ToolsSummary}" Margin="10,0" VerticalAlignment="Center"
                                                       IsVisible="{Binding HasTools}" />
                                            <atom:Button Grid.Column="2" Color="Default" Variant="Text" SizeType="Small" Command="{Binding LoadToolsCommand}"
                                                         IsLoading="{Binding IsLoadingTools}" ToolTip.Tip="{loc:TCodeLangResource McpRestart}">
                                                <atom:Button.Icon><icons:LucideIcon Kind="RefreshCw" /></atom:Button.Icon>
                                            </atom:Button>
                                        </Grid>
                                        <TextBlock Classes="tertiary" Text="{loc:TCodeLangResource McpAnnotationsHint}" IsVisible="{Binding HasTools}" />
                                        <TextBlock Classes="secondary" FontSize="12" Text="{loc:TCodeLangResource McpToolsEmpty}" IsVisible="{Binding HasNoTools}" />
                                        <ItemsControl ItemsSource="{Binding Tools}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:McpToolItemViewModel">
                                                    <Border BorderBrush="{DynamicResource TCode.Divider}" BorderThickness="0,0,0,1" Padding="0,7">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                                <atom:ToggleSwitch SizeType="Small" VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                                                <Button Grid.Column="1" Theme="{StaticResource TCode.RowButton}" Margin="8,0" Padding="4,2" Command="{Binding ToggleExpandedCommand}"
                                                                        HorizontalContentAlignment="Left">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Classes="strong" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Classes="tertiary" Text="{Binding Name}" FontFamily="{StaticResource TCode.MonoFont}" IsVisible="{Binding ShowName}" />
                                                                        <Border Classes="tag" IsVisible="{Binding Dto.ReadOnlyHint}">
                                                                            <TextBlock Text="{loc:TCodeLangResource McpReadOnlyTag}" FontSize="10" Foreground="{DynamicResource TCode.TextSecondary}" />
                                                                        </Border>
                                                                        <Border Classes="tag" IsVisible="{Binding Dto.DestructiveHint}">
                                                                            <TextBlock Text="{loc:TCodeLangResource McpDestructiveTag}" FontSize="10" Foreground="{DynamicResource TCode.Danger}" />
                                                                        </Border>
                                                                        <Border Classes="tag" IsVisible="{Binding Dto.OpenWorldHint}">
                                                                            <TextBlock Text="{loc:TCodeLangResource McpOpenWorldTag}" FontSize="10" Foreground="{DynamicResource TCode.TextSecondary}" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Button>
                                                                <TextBlock Grid.Column="2" Classes="tertiary" Text="{Binding TokensText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                <atom:CheckBox Grid.Column="3" IsChecked="{Binding AlwaysAllow, Mode=TwoWay}" Content="{loc:TCodeLangResource McpAlwaysAllow}"
                                                                               VerticalAlignment="Center" />
                                                            </Grid>
                                                            <SelectableTextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Margin="46,0,0,0"
                                                                                 Foreground="{DynamicResource TCode.TextSecondary}" MaxLines="2"
                                                                                 IsVisible="{Binding !IsExpanded}" />
                                                            <SelectableTextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Margin="46,0,0,0"
                                                                                 Foreground="{DynamicResource TCode.TextSecondary}" IsVisible="{Binding IsExpanded}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- 日志 -->
                                <Border Classes="card" Padding="16,14" IsVisible="{Binding IsExisting}">
                                    <StackPanel Spacing="8">
                                        <Button Theme="{StaticResource TCode.ChipButton}" Command="{Binding ToggleLogCommand}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icons:LucideIcon Kind="ChevronRight" Width="11" Height="11" IsVisible="{Binding !ShowLog}" />
                                                <icons:LucideIcon Kind="ChevronDown" Width="11" Height="11" IsVisible="{Binding ShowLog}" />
                                                <TextBlock Text="{loc:TCodeLangResource McpLogLabel}" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel IsVisible="{Binding ShowLog}">
                                            <TextBlock Classes="tertiary" Text="{loc:TCodeLangResource McpLogEmpty}" IsVisible="{Binding !HasLog}" />
                                            <ScrollViewer MaxHeight="260" atom:ScrollViewer.IsLiteMode="True" IsVisible="{Binding HasLog}">
                                                <ItemsControl ItemsSource="{Binding LogLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <SelectableTextBlock Text="{Binding}" FontSize="11" FontFamily="{StaticResource TCode.MonoFont}" TextWrapping="Wrap"
                                                                                 Foreground="{DynamicResource TCode.TextSecondary}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!-- ======== 导入 ======== -->
    <Grid RowDefinitions="1*,Auto,3*" motion:Presence.IsPresent="{Binding IsImporting}">
        <Border Grid.RowSpan="3" Background="#33000000" />
        <Border Grid.Row="1" Classes="menu" Width="760" HorizontalAlignment="Center" DataContext="{Binding Import}" x:DataType="vm:McpImportViewModel"
                motion:Presence.IsPresent="{Binding $parent[UserControl].((vm:McpSettingsViewModel)DataContext).IsImporting}" motion:Presence.Effect="Zoom" motion:Presence.Distance="12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="18,14,12,6">
                    <TextBlock Text="{loc:TCodeLangResource McpImportTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <atom:Button Grid.Column="1" Color="Default" Variant="Text" SizeType="Small" Command="{Binding CloseCommand}" ToolTip.Tip="{loc:TCodeLangResource Close}">
                        <atom:Button.Icon><icons:LucideIcon Kind="X" /></atom:Button.Icon>
                    </atom:Button>
                </Grid>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="16,2,16,10">
                    <Border Classes="segmented">
                        <motion:IndicatorPanel IndicatorBrush="{DynamicResource TCode.SegmentSelectedBg}" IndicatorBorderBrush="{DynamicResource TCode.SegmentSelectedBorder}" IndicatorRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <Button Theme="{StaticResource TCode.RowButton}" Content="{loc:TCodeLangResource McpImportPaste}" Command="{Binding ChoosePasteCommand}"
                                        Classes.selected="{Binding IsPasteMode}" motion:IndicatorPanel.IsCurrent="{Binding IsPasteMode}" />
                                <Button Theme="{StaticResource TCode.RowButton}" Content="{loc:TCodeLangResource McpImportScan}" Command="{Binding ChooseScanCommand}"
                                        Classes.selected="{Binding IsScanMode}" motion:IndicatorPanel.IsCurrent="{Binding IsScanMode}" />
                            </StackPanel>
                        </motion:IndicatorPanel>
                    </Border>
                    <atom:Button Grid.Column="2" Color="Default" Variant="Outlined" SizeType="Small" Click="OnOpenImportFile"
                                 Content="{loc:TCodeLangResource McpImportFromFile}" />
                </Grid>
                <!-- 底部：目标 + 导入 -->
                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,8,16,14">
                    <TextBlock Classes="secondary" Text="{loc:TCodeLangResource McpImportTargetLabel}" VerticalAlignment="Center" Margin="0,0,10,0"
                               IsVisible="{Binding CanTargetProject}" />
                    <Border Grid.Column="1" Classes="segmented" IsVisible="{Binding CanTargetProject}">
                        <motion:IndicatorPanel IndicatorBrush="{DynamicResource TCode.SegmentSelectedBg}" IndicatorBorderBrush="{DynamicResource TCode.SegmentSelectedBorder}" IndicatorRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <Button Theme="{StaticResource TCode.RowButton}" Content="{loc:TCodeLangResource McpScopeGlobal}" Command="{Binding ChooseGlobalTargetCommand}"
                                        Classes.selected="{Binding !IsProjectTarget}" motion:IndicatorPanel.IsCurrent="{Binding !IsProjectTarget}" />
                                <Button Theme="{StaticResource TCode.RowButton}" Content="{loc:TCodeLangResource McpScopeProject}" Command="{Binding ChooseProjectTargetCommand}"
                                        Classes.selected="{Binding IsProjectTarget}" motion:IndicatorPanel.IsCurrent="{Binding IsProjectTarget}" />
                            </StackPanel>
                        </motion:IndicatorPanel>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource TCode.Danger}" Margin="12,0" TextWrapping="Wrap"
                               VerticalAlignment="Center" IsVisible="{Binding HasError}" />
                    <atom:Button Grid.Column="3" Color="Default" Variant="Solid" SizeType="Small" Command="{Binding ImportCommand}"
                                 IsEnabled="{Binding CanImport}" Content="{Binding ImportButtonText}" />
                </Grid>
                <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource TCode.Divider}" />
                <ScrollViewer MaxHeight="520" atom:ScrollViewer.IsLiteMode="True">
                    <StackPanel Margin="16,0,16,12" Spacing="10">
                        <!-- 粘贴 -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsPasteMode}">
                            <atom:TextArea Classes="multiline" Text="{Binding Text, Mode=TwoWay}" MinLines="6" MaxLines="12"
                                           PlaceholderText="{loc:TCodeLangResource McpImportPastePlaceholder}" />
                            <TextBlock Classes="tertiary" Text="{Binding FormatText}" IsVisible="{Binding FormatText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Text="{Binding ParseError}" FontSize="12" Foreground="{DynamicResource TCode.Danger}" TextWrapping="Wrap" IsVisible="{Binding HasParseError}" />
                        </StackPanel>
                        <!-- 本机扫描 -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsScanMode}">
                            <TextBlock Classes="secondary" FontSize="12" Text="{loc:TCodeLangResource McpImportNoSources}" IsVisible="{Binding HasNoSources}" />
                            <ItemsControl ItemsSource="{Binding Sources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:McpImportSourceViewModel">
                                        <Button Theme="{StaticResource TCode.RowButton}" Classes.selected="{Binding IsSelected}" Margin="0,1"
                                                Command="{Binding $parent[ItemsControl].((vm:McpImportViewModel)DataContext).SelectSourceCommand}" CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="140,*,Auto">
                                                <TextBlock Classes="strong" Text="{Binding Client}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Classes="tertiary" Text="{Binding Path}" FontFamily="{StaticResource TCode.MonoFont}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
                                                <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding CountText}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- 预览 -->
                        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:McpImportItemViewModel">
                                    <Border BorderBrush="{DynamicResource TCode.Divider}" BorderThickness="0,1,0,0" Padding="0,10,0,6">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="Auto,180,Auto,*">
                                                <atom:CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" />
                                                <atom:LineEdit Grid.Column="1" SizeType="Small" Text="{Binding Key, Mode=TwoWay}" FontFamily="{StaticResource TCode.MonoFont}" Margin="6,0,0,0" />
                                                <Border Grid.Column="2" Classes="tag" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding TypeText}" FontSize="10" Foreground="{DynamicResource TCode.TextSecondary}" />
                                                </Border>
                                                <TextBlock Grid.Column="3" Classes="tertiary" Text="{Binding Summary}" FontFamily="{StaticResource TCode.MonoFont}" Margin="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Summary}" />
                                            </Grid>
                                            <StackPanel Margin="30,0,0,0" Spacing="4">
                                                <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource TCode.Danger}" IsVisible="{Binding HasError}" />
                                                <TextBlock Text="{Binding KeyProblem}" FontSize="12" Foreground="{DynamicResource TCode.Danger}" IsVisible="{Binding HasKeyProblem}" />
                                                <TextBlock Text="{loc:TCodeLangResource McpImportOverwrites}" FontSize="12" Foreground="{DynamicResource TCode.GitModified}" IsVisible="{Binding Overwrites}" />
                                                <ItemsControl ItemsSource="{Binding Notes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TCode.TextSecondary}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Classes="tertiary" Text="{Binding DroppedText}" TextWrapping="Wrap" IsVisible="{Binding HasDropped}" />
                                                <ItemsControl ItemsSource="{Binding Inputs}" IsVisible="{Binding HasInputs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:McpImportInputViewModel">
                                                            <Grid ColumnDefinitions="180,*" Margin="0,2">
                                                                <TextBlock Classes="secondary" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                <atom:LineEdit Grid.Column="1" SizeType="Small" Text="{Binding Value, Mode=TwoWay}"
                                                                               PlaceholderText="{loc:TCodeLangResource McpImportInputHint}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <atom:CheckBox IsChecked="{Binding ImportAutoApprove, Mode=TwoWay}" Content="{Binding AutoApproveText}" IsVisible="{Binding HasAutoApprove}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>

    <!-- ======== 导出 ======== -->
    <Grid RowDefinitions="1*,Auto,3*" motion:Presence.IsPresent="{Binding IsExporting}">
        <Border Grid.RowSpan="3" Background="#33000000" />
        <Border Grid.Row="1" Classes="menu" Width="680" HorizontalAlignment="Center" DataContext="{Binding Export}" x:DataType="vm:McpExportViewModel"
                motion:Presence.IsPresent="{Binding $parent[UserControl].((vm:McpSettingsViewModel)DataContext).IsExporting}" motion:Presence.Effect="Zoom" motion:Presence.Distance="12">
            <StackPanel Margin="18,14,18,14" Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{loc:TCodeLangResource McpExportTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <atom:Button Grid.Column="1" Color="Default" Variant="Text" SizeType="Small" Command="{Binding CloseCommand}" ToolTip.Tip="{loc:TCodeLangResource Close}">
                        <atom:Button.Icon><icons:LucideIcon Kind="X" /></atom:Button.Icon>
                    </atom:Button>
                </Grid>
                <TextBlock Classes="secondary" FontSize="12" Text="{loc:TCodeLangResource McpExportHint}" TextWrapping="Wrap" />
                <Border Classes="card" Padding="12,10">
                    <ScrollViewer MaxHeight="380" atom:ScrollViewer.IsLiteMode="True">
                        <SelectableTextBlock Text="{Binding Json}" FontFamily="{StaticResource TCode.MonoFont}" FontSize="12" />
                    </ScrollViewer>
                </Border>
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <atom:CheckBox IsChecked="{Binding Expand, Mode=TwoWay}" Content="{loc:TCodeLangResource McpExportExpand}" VerticalAlignment="Center" />
                    <atom:Button Grid.Column="1" Color="Default" Variant="Outlined" SizeType="Small" Click="OnSaveExport" Margin="0,0,8,0"
                                 Content="{loc:TCodeLangResource SaveToFile}" />
                    <atom:Button Grid.Column="2" Color="Default" Variant="Solid" SizeType="Small" Click="OnCopyExport"
                                 Content="{loc:TCodeLangResource CopyToClipboard}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
    </Panel>
</UserControl>
