<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RootNamespace>TCode.Desktop</RootNamespace>
        <AssemblyName>TCode</AssemblyName>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Windows 可执行文件图标（资源管理器、任务栏）；macOS/Linux 使用 Packaging 下的 icns / hicolor PNG -->
        <ApplicationIcon>Packaging\app.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- 整个客户端必须支持 NativeAOT：发布默认 AOT，构建期启用 AOT / 裁剪分析器 -->
        <PublishAot>true</PublishAot>
    </PropertyGroup>
    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AtomUI.Desktop.Controls" />
        <!-- 冒烟模式（TCode smoke 参数）在发布后的二进制中以无头平台运行真实界面 -->
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="StreamMark.Avalonia" />
        <PackageReference Include="StreamMark.RaTeX" />
        <PackageReference Include="StreamMark.Highlighting.TextMate" />
        <PackageReference Include="StreamMark.Mermaid" />
        <PackageReference Include="StreamMark.Theme.AtomUI" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\TCode.Rpc.Contracts\TCode.Rpc.Contracts.csproj" />
        <ProjectReference Include="..\TCode.Config\TCode.Config.csproj" />
        <!-- Agent Host 作为独立进程运行；引用它只为保证先构建并把产物复制到 agenthost/ 目录 -->
        <ProjectReference Include="..\TCode.AgentHost\TCode.AgentHost.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- 把 Agent Host 的构建产物复制到桌面端输出的 agenthost/ 子目录，运行时由 AgentHostConnection 启动 -->
    <Target Name="CopyAgentHost" AfterTargets="Build">
        <MSBuild Projects="..\TCode.AgentHost\TCode.AgentHost.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_AgentHostTargetPath" />
        </MSBuild>
        <PropertyGroup>
            <_AgentHostDir>@(_AgentHostTargetPath->'%(RootDir)%(Directory)')</_AgentHostDir>
        </PropertyGroup>
        <ItemGroup>
            <_AgentHostFiles Include="$(_AgentHostDir)**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(_AgentHostFiles)" DestinationFiles="@(_AgentHostFiles->'$(OutDir)agenthost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <!-- 发布桌面端时，用相同的运行时标识把 Agent Host 也 AOT 发布到 agenthost/ 子目录 -->
    <Target Name="PublishAgentHost" AfterTargets="Publish">
        <MSBuild Projects="..\TCode.AgentHost\TCode.AgentHost.csproj" Targets="Publish"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishAot=$(PublishAot);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)agenthost'))/" />
    </Target>
</Project>
