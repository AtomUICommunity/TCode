<?xml version="1.0" encoding="utf-8"?>
<!-- TKCode 亮色主题：与暗色主题对称，近黑色作为唯一强调色 -->
<Theme xmlns="https://atomui.net/schemas/theme/v1" Id="TKCodeLight" Name="TKCode Light" Appearance="Light">
  <Algorithms>
    <Algorithm Id="Default" />
  </Algorithms>
  <Tokens>
    <Token Name="ColorPrimary" Value="#1A1A1A" />
    <Token Name="ColorLink" Value="#4A4A4A" />
    <Token Name="ColorTextBase" Value="#1A1A1A" />
    <Token Name="FontSize" Value="13" />
    <Token Name="BorderRadius" Value="8" />
    <Token Name="ControlHeight" Value="30" />
    <Token Name="ColorBgContainer" Value="#FFFFFF" />
    <Token Name="ColorBgLayout" Value="#F7F7F7" />
    <Token Name="ColorBgElevated" Value="#FFFFFF" />
    <Token Name="ColorBorder" Value="#DCDCDC" />
    <Token Name="ColorBorderSecondary" Value="#E8E8E8" />
    <Token Name="FontSizeSM" Value="12" />
    <Token Name="FontHeightSM" Value="20" />
    <Token Name="RelativeLineHeightSM" Value="1.6667" />
    <Token Name="BorderRadiusLG" Value="12" />
    <Token Name="BorderRadiusSM" Value="6" />
  </Tokens>
  <Controls>
    <Control Catalog="AtomUI" Id="ToggleSwitch" Algorithm="Disabled">
      <Tokens>
        <Token Name="SwitchColor" Value="#2F9E5C" />
      </Tokens>
    </Control>
  </Controls>
</Theme>
