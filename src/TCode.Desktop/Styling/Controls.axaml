<!--
  TCode 复合控件的主题与文字层级。
  可交互的通用按钮使用 AtomUI 的 atom:Button；这里只为侧栏行、磁贴、标签页、分割条等
  AtomUI 没有对应形态的表面提供 ControlTheme。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:motion="using:TCode.Desktop.Motion">
    <Styles.Resources>
        <!-- 侧栏导航、列表行、菜单行：透明背景，悬停/选中时填充 -->
        <ControlTheme x:Key="TCode.RowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TCode.TextPrimary}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="{StaticResource TCode.RadiusSmall}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- 悬停 / 按下 / 选中：颜色渐变而不是瞬间切换；按下轻微缩小（只用于胶囊、磁贴这类独立按钮，见下方主题） -->
            <Setter Property="Transitions">
                <Transitions>
                    <motion:MotionBrushTransition Property="Background" />
                    <motion:MotionBrushTransition Property="BorderBrush" />
                    <motion:MotionBrushTransition Property="Foreground" />
                    <motion:MotionTransformTransition Property="RenderTransform" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource TCode.HoverBg}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource TCode.SelectedBg}" />
            </Style>
            <Style Selector="^.selected">
                <Setter Property="Background" Value="{DynamicResource TCode.SelectedBg}" />
            </Style>
        </ControlTheme>

        <!-- 工作台起始页磁贴 -->
        <ControlTheme x:Key="TCode.TileButton" TargetType="Button" BasedOn="{StaticResource TCode.RowButton}">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource TCode.RadiusMedium}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource TCode.TileBorder}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource TCode.TileHoverBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TCode.TileHoverBorder}" />
                <Setter Property="RenderTransform" Value="translateY(-2px)" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.97)" />
            </Style>
        </ControlTheme>

        <!-- 工作台标签页 -->
        <ControlTheme x:Key="TCode.TabButton" TargetType="Button" BasedOn="{StaticResource TCode.RowButton}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,0,6,0" />
            <Style Selector="^.active">
                <Setter Property="Background" Value="{DynamicResource TCode.TabActiveBg}" />
            </Style>
        </ControlTheme>

        <!-- 胶囊按钮（Plan New Idea / Multitask / 上下文选择器） -->
        <ControlTheme x:Key="TCode.PillButton" TargetType="Button" BasedOn="{StaticResource TCode.RowButton}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource TCode.PillBorder}" />
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.96)" />
            </Style>
        </ControlTheme>

        <!-- 无边框的文字下拉（仓库 ⌄ / 分支 ⌄ / 环境 ⌄） -->
        <ControlTheme x:Key="TCode.ChipButton" TargetType="Button" BasedOn="{StaticResource TCode.RowButton}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TCode.TextSecondary}" />
            <Setter Property="Padding" Value="6,0" />
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource TCode.TextPrimary}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.96)" />
            </Style>
        </ControlTheme>

        <!-- 弹层菜单项：比 RowButton 更紧凑，悬停色更亮（模型选择器、项目 / 分支选择器、命令面板） -->
        <ControlTheme x:Key="TCode.MenuItem" TargetType="Button" BasedOn="{StaticResource TCode.RowButton}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource TCode.MenuItemHoverBg}" />
            </Style>
            <Style Selector="^.selected">
                <Setter Property="Background" Value="{DynamicResource TCode.MenuItemHoverBg}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45" />
            </Style>
        </ControlTheme>

        <!-- 图标页签：选中时底部 2px 强调色下划线（模型选择器顶部的 Provider 页签） -->
        <ControlTheme x:Key="TCode.IconTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TCode.TextSecondary}" />
            <Setter Property="Transitions">
                <Transitions>
                    <motion:MotionBrushTransition Property="Foreground" />
                    <motion:MotionTransformTransition Property="RenderTransform" />
                </Transitions>
            </Setter>
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- 下划线：选中时从中间展开 -->
                        <Border x:Name="PART_Underline" Height="2" Margin="7,0" CornerRadius="1" VerticalAlignment="Bottom"
                                Background="{DynamicResource TCode.Accent}" Opacity="0" RenderTransform="scaleX(0.2)">
                            <Border.Transitions>
                                <Transitions>
                                    <motion:MotionDoubleTransition Property="Opacity" />
                                    <motion:MotionTransformTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{x:Static motion:MotionTokens.EaseSpring}" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource TCode.TextPrimary}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.92)" />
            </Style>
            <Style Selector="^.active">
                <Setter Property="Foreground" Value="{DynamicResource TCode.TextPrimary}" />
                <Style Selector="^ /template/ Border#PART_Underline">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="RenderTransform" Value="scaleX(1)" />
                </Style>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="TCode.Splitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource TCode.Divider}" />
            <Setter Property="Width" Value="1" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- 视觉上 1px，命中区域左右各扩 3px -->
                    <Border Background="Transparent" Margin="-3,0">
                        <Border Background="{TemplateBinding Background}" Width="1" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- 弹层卡片：半透明深色、低对比描边、柔和投影 -->
    <Style Selector="Border.menu">
        <Setter Property="Background" Value="{DynamicResource TCode.MenuBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TCode.MenuBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource TCode.RadiusMenu}" />
        <Setter Property="BoxShadow" Value="{StaticResource TCode.MenuShadow}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.menuDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource TCode.MenuBorder}" />
    </Style>

    <!-- 设置页卡片与分组行 -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource TCode.CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TCode.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource TCode.RadiusMedium}" />
    </Style>
    <!-- 分段选择：外框 + 选中项填充 -->
    <Style Selector="Border.segmented">
        <Setter Property="Background" Value="{DynamicResource TCode.MenuInputBg}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.segmented Button">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Border.segmented Button.selected">
        <Setter Property="Background" Value="{DynamicResource TCode.SegmentSelectedBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TCode.SegmentSelectedBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.segmented Button">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.inputBox">
        <Setter Property="Background" Value="{DynamicResource TCode.MenuInputBg}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 键位提示：⌘1、esc、↵ -->
    <Style Selector="Border.kbd">
        <Setter Property="Background" Value="{DynamicResource TCode.KbdBg}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.kbd > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TCode.KbdFg}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!--
      文字层级。注意：不要给所有 TextBlock 设置 Foreground / FontSize ——
      那会覆盖 AtomUI 控件模板内部的文字（实心按钮、危险按钮、复选框、小号控件），导致亮 / 暗主题下文字不可见或字号错乱。
      正文颜色由窗口的 Foreground 继承（MainWindow.Foreground = TCode.TextPrimary），层级通过样式类表达。
    -->
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TCode.TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.tertiary">
        <Setter Property="Foreground" Value="{DynamicResource TCode.TextTertiary}" />
        <Setter Property="FontSize" Value="{StaticResource TCode.FontSizeSmall}" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="Foreground" Value="{DynamicResource TCode.TextTertiary}" />
        <Setter Property="FontSize" Value="{StaticResource TCode.FontSizeSmall}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.strong">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="#553B82F6" />
    </Style>
</Styles>
